// A custom title bar picked by the operating system: Linux draws its window
// buttons on the right, macOS on the left. TitleBar is a Row; the buttons are
// ordinary IconButtons, so only the empty space drags the window.

Window {
	id:       main
	title:    "Custom title bar"
	width:    900
	height:   600
	titleBar: custom

	Column {
		spacing: 0

		TitleBar {
			visible:        app.os == "linux" || app.os == "windows"
			height:         44
			paddingLeft:    12
			paddingRight:   4
			spacing:        4
			crossAxisAlign: center
			background:     theme.surfaceContainer

			Text {
				text: "Custom title bar"
				role: titleSmall
			}

			Rectangle {
				flex: 1
			}

			IconButton {
				id:      lnxMin
				icon:    remove
				variant: text
				size:    32
			}

			IconButton {
				id:      lnxMax
				icon:    crop_square
				variant: text
				size:    32
			}

			IconButton {
				id:      lnxClose
				icon:    close
				variant: text
				size:    32
			}
		}

		TitleBar {
			visible:        app.os == "darwin"
			height:         44
			paddingLeft:    4
			paddingRight:   12
			spacing:        4
			crossAxisAlign: center
			background:     theme.surfaceContainer

			IconButton {
				id:      macClose
				icon:    close
				variant: text
				size:    32
			}

			IconButton {
				id:      macMin
				icon:    remove
				variant: text
				size:    32
			}

			IconButton {
				id:      macMax
				icon:    crop_square
				variant: text
				size:    32
			}

			Rectangle {
				flex: 1
			}

			Text {
				text: "Custom title bar"
				role: titleSmall
			}

			Rectangle {
				flex: 1
			}
		}

		Column {
			flex:           1
			padding:        32
			spacing:        12
			crossAxisAlign: center

			Text {
				text: "Drag the title bar to move the window."
				role: titleLarge
			}

			Text {
				text:  "The buttons call ui.Window.Minimize, ToggleMaximize and Close."
				color: theme.onSurfaceVariant
			}

			Text {
				text:  "Drag the bar to move the window and the outer edge to resize it."
				color: theme.onSurfaceVariant
				wrap:  true
				width: 520
				align: center
			}
		}
	}
}
