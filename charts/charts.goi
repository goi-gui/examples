// Charts: each element picks its own look through properties. A chart either
// holds its numbers itself (`categories` plus one ChartSeries child) or takes
// them from Go with SetData.
//
//	grid, axis    the value lines and the labels
//	legend        a key for the series
//	values        the value written next to each point, bar or slice
//	smooth        a curve instead of straight segments (line, area)
//	points        a dot at each value (line, scatter)
//	stacked       add the series instead of grouping them (bar, area)
//	horizontal    run the bars left to right (bar)
//	innerRadius   a donut instead of a pie, as a share of the radius
//	startAngle    where the first slice begins, in degrees
//	min, max      pin the value scale instead of following the data
//	textColor     the colour of every label the chart writes
//	gridColor     the colour of the value lines, rings and the gauge track
//
// A legend entry is a switch: clicking it hides that series and clicking again
// brings it back, and the value scale follows what is left.

bridge {
	onPick func(name string, index int)
}

Window {
	id:     charts
	title:  "Charts"
	width:  1100
	height: 820

	Column {
		padding: 24
		gap:     20

		Text {
			text: "Charts"
			role: headlineSmall
		}

		Row {
			gap: 20

			LineChart {
				id:       revenue
				flex:     1
				height:   240
				legend:   true
				points:   true
				smooth:   true
				onSelect: bridge.onPick("line", event)
			}

			AreaChart {
				id:       costs
				flex:     1
				height:   240
				stacked:  true
				legend:   true
				onSelect: bridge.onPick("area", event)
			}
		}

		Row {
			gap: 20

			BarChart {
				id:       bar
				flex:     1
				height:   240
				legend:   true
				values:   true
				onSelect: bridge.onPick("bar", event)
			}

			PieChart {
				id:          channels
				width:       260
				height:      240
				innerRadius: 0.55
				legend:      true
				values:      true
				startAngle:  -90
				onSelect:    bridge.onPick("pie", event)
				categories:  "Direct, Search, Social, Email"

				// One colour per slice: a role follows the scheme, the literal
				// is fixed.
				ChartSeries {
					values: "42, 27, 18, 13"
					colors: "primary, tertiary, secondary, #c62828"
				}
			}

			ScatterChart {
				id:       latency
				flex:     1
				height:   240
				points:   true
				onSelect: bridge.onPick("scatter", event)
			}
		}

		Row {
			gap: 20

			RadarChart {
				id:       satisfaction
				flex:     1
				height:   260
				legend:   true
				points:   true
				values:   false
				onSelect: bridge.onPick("radar", event)
			}

			// A chart can hold its own data: this gauge needs no Go at all.
			GaugeChart {
				id:       uptime
				width:    320
				height:   260
				max:      100
				onSelect: bridge.onPick("gauge", event)

				ChartSeries {
					label:  "Uptime"
					values: "99.4"
				}
			}
		}

		Text {
			id:   status
			text: "click a point, or a legend entry to hide its series"
			role: bodyMedium
		}
	}
}
