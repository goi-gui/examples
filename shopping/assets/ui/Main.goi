bridge {
	isReviewsExpanded  bool
	selectedSize       int
	selectedImageIndex int
	colors             []color
	image1Path         string
	image2Path         string
	image3Path         string
	selectedColorIndex int
	isFavourite        bool
	onToggleReviews    func()
	onToggleFavourite  func()
	onSelectColor      func(index int)
	onSelectSize       func(size int)
	onSelectImage      func(index int)
}

Window {
	theme:           app.systemMode == "light" ? lightFromSeed : darkFromSeed
	title:           "Shopping"
	width:           1000
	height:          1000
	fontFamily:      "Nunito"
	themeTransition: wipe 1s

	Column {
		mainAxisAlign:  center
		crossAxisAlign: center

		Row {
			NavigationRail {
				crossAxisAlign: center
				paddingY:       20
				background:     theme.surface
				visible:        responsive {
					base: false
					md: true
				}

				Icon {
					icon: diamond
					size: 40
				}

				Rectangle {
					flex: 1
				}

				NavigationItem {
					leadingIcon: diamond
					label:       "Featured"
					selected:    true
				}

				NavigationItem {
					leadingIcon: chair
					label:       "Apartment"
				}

				NavigationItem {
					leadingIcon: watch
					label:       "Accessories"
				}

				NavigationItem {
					leadingIcon: apparel
					label:       "Apparel"
				}

				NavigationItem {
					leadingIcon: potted_plant
					label:       "Objects"
				}

				Rectangle {
					flex: 1
				}
			}

			Stack {
				flex:           1
				crossAxisAlign: center

				Column {
					height: window.height

					// mobile top bar
					Row {
						crossAxisAlign: center
						mainAxisAlign:  spaceBetween
						padding:        20
						visible:        responsive {
							base: true
							md: false
						}

						Row {
							gap: 20

							IconButton {
								icon:    arrow_left_alt
								variant: tonal
							}

							// Title
							Text {
								text:     "Child T-shirt"
								fontSize: 36
							}
						}

						// Price
						Text {
							role:   titleLarge
							text:   "$240"
							weight: 600
						}
					}

					Column {
						flex:          1
						paddingBottom: responsive {
							base: 180
							md: 0
						}

						Flex {
							direction:    responsive {
								base: column
								md: row
							}
							padding:      20
							paddingRight: 0

							// mobile breadcrumb
							Breadcrumb {
								visible:      responsive {
									base: true
									md: false
								}
								marginBottom: 20

								Text {
									text:  "Featured"
									color: theme.onSurfaceVariant
								}

								Text {
									text:  "LMBRJK"
									color: theme.onSurfaceVariant
								}

								Text {
									text:  "Tops"
									color: theme.onSurface
								}
							}

							// Images
							Flex {
								scroll:         responsive {
									base: true
									md: false
								}
								scrollSnapType: mandatory
								direction:      responsive {
									base: row
									md: column
								}
								width:          responsive {
									base: 100%
									md: 350
								}
								paddingRight:   responsive {
									base: 20
									md: 0
								}
								gap:            20

								Image {
									src:             bridge.image1Path
									width:           responsive {
										base: 80%
										md: 100%
									}
									height:          responsive {
										base: 300
										md: bridge.selectedImageIndex == 0 && window.width >= 768 ? 500 : 200
									}
									radius:          20
									scrollSnapAlign: start
									onClick:         bridge.onSelectImage(0)
									transition:      height 500ms
									ripple:          true
									crossfadeSrc:    500ms
								}

								Image {
									src:             bridge.image2Path
									width:           responsive {
										base: 80%
										md: 100%
									}
									height:          responsive {
										base: 300
										md: bridge.selectedImageIndex == 1 && window.width >= 768 ? 500 : 200
									}
									radius:          20
									scrollSnapAlign: start
									onClick:         bridge.onSelectImage(1)
									transition:      height 500ms
									ripple:          true
									crossfadeSrc:    500ms
								}

								Image {
									src:             bridge.image3Path
									width:           responsive {
										base: 80%
										md: 100%
									}
									height:          responsive {
										base: 300
										md: bridge.selectedImageIndex == 2 && window.width >= 768 ? 500 : 200
									}
									radius:          20
									scrollSnapAlign: start
									onClick:         bridge.onSelectImage(2)
									transition:      height 500ms
									ripple:          true
									crossfadeSrc:    500ms
								}
								// for i, imageList := range bridge.images {
								// 	if i != bridge.selectedColorIndex {
								// 		continue
								// 	}
								// for j, imagePath := range imageList {
								// 	Image {
								// 		src:             imagePath
								// 		width:           responsive {
								// 			base: 80%
								// 			md: 100%
								// 		}
								// 		height:          responsive {
								// 			base: 300
								// 			md: bridge.selectedImageIndex == j && window.width >= 768 ? 500 : 200
								// 		}
								// 		radius:          20
								// 		scrollSnapAlign: start
								// 		onClick:         bridge.onSelectImage(j)
								// 		transition:      height 500ms
								// 		ripple:          true
								// 	}
								// }
								// }
							}

							// content
							Column {
								flex:         1
								padding:      20
								paddingRight: 0

								// content top
								Row {
									mainAxisAlign: spaceBetween
									paddingRight:  20
									visible:       responsive {
										base: false
										md: true
									}

									// desktop breadcrumb
									Breadcrumb {
										Text {
											text:  "Featured"
											color: theme.onSurfaceVariant
										}

										Text {
											text:  "LMBRJK"
											color: theme.onSurfaceVariant
										}

										Text {
											text:  "Tops"
											color: theme.onSurface
										}
									}

									// Price
									Text {
										role:   titleLarge
										text:   "$240"
										weight: 600
									}
								}

								// Title
								Text {
									text:       "Child T-shirt"
									fontSize:   36
									fontWeight: 500
									marginTop:  20
									visible:    responsive {
										base: false
										md: true
									}
								}

								// Description
								Column {
									marginTop:    20
									paddingRight: 20

									Text {
										text: "Give your little one the ultimate combination of comfort, durability, and vibrant style with our Everyday Kids' T-Shirt. Crafted with care for active kids, this tee is designed to keep up with every adventure—from playground fun to cozy days at home."
										wrap: true
									}
								}

								// Size
								Row {
									marginTop:      20
									crossAxisAlign: center
									gap:            20

									Text {
										text: "Size"
									}

									Row {
										gap:           10
										flex:          1
										hideScrollbar: true
										paddingRight:  20

										for i := range 17 {
											if i % 2 == 0 {
												Chip {
													label:      formatf("%02d", i)
													background: conditional {
														theme.primaryContainer: i == bridge.selectedSize
													}
													labelColor: conditional {
														theme.onPrimaryContainer: i == bridge.selectedSize
													}
													onClick:    bridge.onSelectSize(i)
												}
											}
										}
									}
								}

								Column {
									paddingRight: 20

									// Color
									Row {
										marginTop:      20
										crossAxisAlign: center
										gap:            20
										height:         50

										Text {
											text: "Color"
										}

										Row {
											gap:            10
											flex:           1
											crossAxisAlign: center

											for i, c := range bridge.colors {
												Rectangle {
													background:      c
													width:           48
													height:          bridge.selectedColorIndex == i ? 40 : 20
													radius:          10
													borderThickness: bridge.selectedColorIndex == i ? 2 : 0
													borderColor:     theme.onSurface
													onClick:         bridge.onSelectColor(i)
													transition:      height 200ms
												}
											}
										}
									}

									// Buttons
									Row {
										marginTop: 20
										height:    50
										gap:       10

										Button {
											variant:    tonal
											background: theme.primaryContainer
											color:      theme.onPrimaryContainer
											label:      "Add to shopping basket"
											radius:     10
											flex:       1
											height:     100%
										}

										IconButton {
											icon:       favorite
											iconColor:  conditional {
												red: bridge.isFavourite
											}
											filledIcon: bridge.isFavourite
											variant:    tonal
											background: theme.primaryContainer
											radius:     10
											height:     100%
											width:      50
											onClick:    bridge.onToggleFavourite()
										}
									}

									// More Details
									Row {
										marginTop:  20
										background: theme.surfaceVariant
										padding:    16
										radius:     10

										Text {
											text: "More details"
											role: titleMedium
										}
									}

									// Ratings and Reviews
									Column {
										padding:    10
										marginTop:  10
										gap:        conditional {
											0: !bridge.isReviewsExpanded
											6: bridge.isReviewsExpanded
										}
										background: theme.secondaryContainer
										radius:     10
										transition: gap 200ms

										// Title
										Row {
											padding:        10
											mainAxisAlign:  spaceBetween
											crossAxisAlign: center
											background:     theme.surfaceContainer
											radiusTop:      5
											radiusBottom:   bridge.isReviewsExpanded ? 0 : 5
											transition:     radiusBottom 200ms
											onClick:        bridge.onToggleReviews()

											Text {
												text: "Ratings and Reviews"
												role: titleMedium
											}

											Icon {
												icon: bridge.isReviewsExpanded ? keyboard_arrow_up : keyboard_arrow_down
											}
										}

										Column {
											height:       conditional {
												0: !bridge.isReviewsExpanded
												120: bridge.isReviewsExpanded
											}
											padding:      10
											background:   theme.surfaceContainer
											radiusBottom: 5
											transition:   height 500ms

											// Review title
											Row {
												background:     theme.surfaceContainer
												crossAxisAlign: center
												gap:            10

												Row {
													for i := range 5 {
														Icon {
															icon:       star
															size:       20
															filledIcon: i < 4
														}
													}
												}

												Text {
													text:       "Super soft and holds up great in the wash!"
													role:       titleSmall
													fontWeight: 600
													truncate:   true
													flex:       1
												}
											}

											Text {
												text:     "Bought this in both pink and purple for my 5-year-old, and they have quickly become her absolute favorite shirts. The cotton is noticeably softer and thicker than most basic kids' tees—no scratchiness at all, which is a huge plus for her sensitive skin. I’ve already washed them several times and there’s been zero shrinking or fading; the colors are still super vibrant. True to size with a great relaxed fit for running around at the playground. Definitely coming back for the blue one!"
												wrap:     true
												maxLines: 4
											}
										}
									}
								}
							}
						}
					}
				}

				// NavigationBar Bottom
				Positioned {
					visible: responsive {
						base: true
						md: false
					}
					bottom:  0

					NavigationBar {
						NavigationItem {
							leadingIcon: diamond
							label:       "Featured"
							selected:    true
						}

						NavigationItem {
							leadingIcon: chair
							label:       "Apartment"
						}

						NavigationItem {
							leadingIcon: watch
							label:       "Accessories"
						}

						NavigationItem {
							leadingIcon: apparel
							label:       "Apparel"
						}

						NavigationItem {
							leadingIcon: potted_plant
							label:       "Objects"
						}
					}
				}

				// Shopping Cart
				Positioned {
					bottom: responsive {
						base: 100
						md: 20
					}
					right:  responsive {
						base: -1
						md: 20
					}

					Row {
						background:     theme.primaryContainer
						shadow:         2 2 5 #00000033
						padding:        20
						radius:         10
						crossAxisAlign: center
						gap:            10
						ripple:         true
						cursor:         pointer

						Icon {
							icon:  shopping_cart
							color: theme.onPrimaryContainer
						}

						Image {
							src:    "goi://images/shirtmodel.jpg"
							height: 50
							width:  30
							radius: 10
						}

						Image {
							src:    "goi://images/shirtmodel2.jpg"
							width:  50
							height: 40
							radius: 10
						}

						Text {
							text: "+1"
							role: titleMedium
						}
					}
				}
			}
		}
	}
}
