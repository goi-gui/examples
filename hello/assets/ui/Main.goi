// Nested boxes: radius, border, padding and alignment.

Window {
	title:  "Hello"
	width:  640
	height: 400
	theme:  app.systemMode

	Column {
		width:          100%
		height:         100%
		crossAxisAlign: center
		mainAxisAlign:  center
		gap:            20

		SVG {
			src:    "goi://images/goi.svg"
			width:  100
			height: 100
		}

		Text {
			text: "Hello, World!"
		}
	}
}
