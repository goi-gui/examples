// A place search: the left pane owns the field, the status and the result list;
// the right pane is the map. The bridge block is the whole connection — Go
// supplies the values and the two HTTP calls, and the design never knows about
// them.
//
// Every polygon the place API returns becomes one Geom child, built by the loop
// from the bridge's list; the marker is a Point with an icon, and the route is a
// Path the app fills from the search hits.

bridge {
	Status   string
	Loading  bool
	Selected string
	HasPlace bool
	Marker   []float64
	Results  []Result
	Geoms    []GeomData
	onSearch func(query string)
	onPick   func(id string)
}

type Result {
	ID     string
	Label  string
	Detail string
}

// GeomData is one polygon: a flat [lon, lat, lon, lat, ...] ring.
type GeomData {
	Data []float64
}

Window {
	id:     main
	title:  "goi map — PiriAPI"
	width:  1100
	height: 740
	theme:  app.systemMode

	Row {
		width:          100%
		height:         100%
		crossAxisAlign: stretch

		// ---------------------------------------------------------- search
		Column {
			width:      380
			padding:    20
			spacing:    12
			background: theme.surfaceContainerLow

			Text {
				text: "Search Location"
				role: "headlineSmall"
			}

			TextField {
				id:       search
				label:    "Location Name"
				onSubmit: bridge.onSearch(event)
				width:    100%
			}

			if bridge.Loading {
				Row {
					mainAxisAlign: center

					LoadingIndicator {}
				}
			}

			Text {
				text:  bridge.Status
				role:  "labelMedium"
				color: theme.onSurfaceVariant
			}

			List {
				width:  100%
				flex:   1
				scroll: true

				for _, r := range bridge.Results {
					ListItem {
						label:        r.Label
						supporting:   r.Detail
						trailingIcon: chevron_right
						selected:     r.ID == bridge.Selected
						onClick:      bridge.onPick(r.ID)
					}
				}
			}

			Text {
				text:  "PiriAPI · veri © OpenStreetMap contributors"
				role:  "labelSmall"
				color: theme.onSurfaceVariant
			}
		}

		// ------------------------------------------------------------- map
		Column {
			flex:    1
			padding: 12

			Map {
				id:          map
				width:       100%
				flex:        1
				radius:      16
				attribution: "© OpenStreetMap contributors · PiriAPI"

				// One Geom per polygon of the selected place.
				for _, g := range bridge.Geoms {
					Geom {
						data:      g.Data
						lineColor: theme.primary
						fillColor: #6750a433
					}
				}

				// The search hits, joined in the order the API ranked them.
				Path {
					id:        route
					lineColor: theme.error
				}

				// A pin at the selected place's centre, hidden until there is one.
				Point {
					visible:    bridge.HasPlace
					coordinate: bridge.Marker

					IconButton {
						icon:    location_on
						variant: filled
					}
				}
			}
		}
	}
}
