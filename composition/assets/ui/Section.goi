// Section: a titled block whose body comes from whoever instantiates it.
// `$children` is the unnamed slot; `$actions` is a named one, next to the title.

props {
	title string
}

Column {
	spacing: 8

	Row {
		spacing: 8

		Text {
			text: props.title
			role: "titleMedium"
		}

		Rectangle {
			flex: 1
		}

		// The slot is filled by some instances and not others; len is how the
		// fragment knows which, without a second file.
		if len($actions) > 0 {
			$actions
		}
	}

	$children
}
