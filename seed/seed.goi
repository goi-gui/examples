// Seed: one colour, a whole scheme.

bridge {
	onToggleScheme func(isDark bool)
	onSetSeedColor func(c color)
}

Window {
	id:     main
	title:  "Seed colour"
	width:  520
	height: 620
	theme:  lightFromSeed

	Column {
		spacing: 0

		TopAppBar {
			label: "Seed colour"
		}

		Column {
			flex:           1
			padding:        24
			spacing:        20
			crossAxisAlign: center
			mainAxisAlign:  center
			paddingBottom:  100

			Text {
				text: "One colour, a whole scheme"
				role: "titleMedium"
			}

			Text {
				text:  "Every role below comes from the seed through a tonal palette."
				role:  "bodyMedium"
				wrap:  true
				width: 420
				align: center
			}

			Text {
				text:      "Select a color"
				role:      "titleLarge"
				align:     center
				marginTop: 40
			}

			Row {
				spacing:       12
				mainAxisAlign: center

				Rectangle {
					background: #411f89
					width:      30
					height:     30
					radius:     15
					cursor:     pointer
					onClick:    bridge.onSetSeedColor(#411f89)
				}

				Rectangle {
					background: #ff0000
					width:      30
					height:     30
					radius:     15
					cursor:     pointer
					onClick:    bridge.onSetSeedColor(#ff0000)
				}

				Rectangle {
					background: #00ff00
					width:      30
					height:     30
					radius:     15
					cursor:     pointer
					onClick:    bridge.onSetSeedColor(#00ff00)
				}

				Rectangle {
					background: #ffff00
					width:      30
					height:     30
					radius:     15
					cursor:     pointer
					onClick:    bridge.onSetSeedColor(#ffff00)
				}
			}

			Switch {
				id:       darkSwitch
				checked:  false
				iconOn:   dark_mode
				iconOff:  light_mode
				label:    app.dark ? "Dark" : "Light"
				onToggle: bridge.onToggleScheme(event)
			}

			Card {
				width:   440
				variant: filled

				Column {
					spacing: 16

					Row {
						spacing: 12

						Column {
							spacing: 6

							Column {
								width:      72
								height:     56
								radius:     12
								background: theme.primary
							}

							Text {
								text: "primary"
								role: "labelSmall"
							}
						}

						Column {
							spacing: 6

							Column {
								width:      72
								height:     56
								radius:     12
								background: theme.primaryContainer
							}

							Text {
								text: "container"
								role: "labelSmall"
							}
						}

						Column {
							spacing: 6

							Column {
								width:      72
								height:     56
								radius:     12
								background: theme.secondary
							}

							Text {
								text: "secondary"
								role: "labelSmall"
							}
						}

						Column {
							spacing: 6

							Column {
								width:      72
								height:     56
								radius:     12
								background: theme.tertiary
							}

							Text {
								text: "tertiary"
								role: "labelSmall"
							}
						}
					}

					Text {
						id:   current
						text: formatf("Selected Theme: %s", app.dark ? "darkFromSeed" : "lightFromSeed")
						role: "labelMedium"
					}
				}
			}
		}
	}
}
