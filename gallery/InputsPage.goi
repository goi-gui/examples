Column {
	id:             pageInputs
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Selection"
			role: "titleMedium"
		}

		Checkbox {
			id:      check
			label:   "Checkbox"
			checked: true
			width:   220
		}

		RadioButton {
			label:   "Radio button"
			checked: true
			width:   220
		}

		Switch {
			id:      switchOn
			label:   "Switch"
			checked: true
			width:   220
		}

		// iconOn/iconOff override icon; empty means no glyph.
		Switch {
			label:   "Switch with icons"
			checked: true
			iconOn:  check
			iconOff: close
			width:   240
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Slider"
			role: "titleMedium"
		}

		Slider {
			id:    slider
			value: 0.4
			min:   0
			max:   1
			width: responsive {
				base: 280
				md: 360
			}
		}

		Text {
			text: "Drag the handle, or use the arrow keys."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Slider shapes"
			role: "titleMedium"
		}

		Text {
			text: "Standard, centered (fills out from 0.5) and range."
			role: "bodySmall"
		}

		Slider {
			value: 0.4
			min:   0
			max:   1
			width: responsive {
				base: 280
				md: 360
			}
		}

		Slider {
			variant: centered
			value:   0.7
			min:     0
			max:     1
			width:   responsive {
				base: 280
				md: 360
			}
		}

		Slider {
			variant: centered
			center:  0.25
			value:   0.7
			min:     0
			max:     1
			width:   responsive {
				base: 280
				md: 360
			}
		}

		Slider {
			variant: range
			value:   20
			end:     70
			min:     0
			max:     100
			step:    5
			width:   responsive {
				base: 280
				md: 360
			}
		}

		Text {
			text:  "The range slider takes whichever handle is nearer to a press; a fourth slider with a custom center is above it."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 360
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Chips"
			role: "titleMedium"
		}

		Wrap {
			spacing: 8

			Chip {
				label: "Assist"
				icon:  event
			}

			Chip {
				label:    "Filter"
				variant:  filter
				selected: true
			}

			Chip {
				label:   "Input"
				variant: input
			}

			Chip {
				label:   "Suggestion"
				variant: suggestion
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Text fields"
			role: "titleMedium"
		}

		TextField {
			id:          field
			label:       "Label"
			placeholder: "Filled text field"
			variant:     filled
			width:       responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:       "Label"
			placeholder: "Outlined field"
			variant:     outlined
			width:       responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:       "Styled field"
			placeholder: "Your own box"
			background:  theme.surfaceContainerHigh
			borderWidth: 2
			borderColor: theme.tertiary
			radius:      18
			color:       theme.onSurface
			width:       responsive {
				base: 280
				md: 360
			}
		}

		Text {
			text:  "A field takes the design's background, border, radius and color instead of the variant's own."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:   "Email"
			text:    "user@example.com"
			icon:    mail
			variant: filled
			width:   responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:       "Supporting text"
			placeholder: "With a helper line"
			supporting:  "Shown under the field"
			variant:     outlined
			width:       responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:      "Phone"
			type:       numeric
			mask:       "(###) ###-####"
			supporting: "Digits only, with the mask's punctuation"
			width:      responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			label:      "Ticket"
			type:       alphanumeric
			supporting: "Letters and digits only"
			variant:    outlined
			width:      responsive {
				base: 280
				md: 360
			}
		}

		TextField {
			id:          hex
			label:       "Hex colour"
			placeholder: "#ff8800"
			type:        "0123456789abcdefABCDEF#"
			supporting:  "0-9, a-f, A-F and #"
			width:       responsive {
				base: 280
				md: 360
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Search bar"
			role: "titleMedium"
		}

		SearchBar {
			placeholder: "Search components"
			width:       responsive {
				base: 280
				md: 400
			}
		}

		Text {
			text: "Click it and type: the value scrolls and selects."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Text area"
			role: "titleMedium"
		}

		TextArea {
			id:          notes
			label:       "Notes"
			placeholder: "Enter starts a new line"
			text:        "A multiline field: Enter adds a line, Home and End work per line, and the caret scrolls when the text outgrows the box."
			supporting:  "supporting text sits under the field"
			width:       responsive {
				base: 300
				md: 420
			}
			height:      140
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Date picker"
			role: "titleMedium"
		}

		Text {
			id:   dateValue
			text: "No date picked"
			role: "bodySmall"
		}

		DatePicker {
			id:    datePicker
			label: "Select date"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Time picker"
			role: "titleMedium"
		}

		Text {
			id:   timeValue
			text: "No time picked"
			role: "bodySmall"
		}

		Row {
			spacing:        28
			crossAxisAlign: start

			TimePicker {
				id:    timePicker
				label: "Select time"
			}

			TimePicker {
				id:         timeInput
				variant:    input
				label:      "Enter time, 24-hour"
				text:       "19:30"
				hourFormat: 24
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Colour picker"
			role: "titleMedium"
		}

		Text {
			id:   colorValue
			text: "No colour picked"
			role: "bodySmall"
		}

		ColorPicker {
			id:    colorPicker
			label: "Select colour"
			text:  "#6750a480"
		}

		Text {
			text:  "The value is #rrggbb, or #rrggbbaa when translucent: the checkerboard bar sets opacity, and the hex field takes either form."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 360
			}
		}
	}
}
