// Markdown: one document, rendered as ordinary elements. The headings, lists,
// code block, quote and table below are all built from the Markdown component's
// source; the inline markup becomes styled runs on a RichText, so bold, italic,
// code, strikethrough and links read the way the document wrote them.

Column {
	id:             pageMarkdown
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start
	scrollShadow:   true

	Column {
		spacing: 4
		width:   560

		Text {
			text: "Markdown"
			role: "titleMedium"
		}

		Markdown {
			id:    mdSample
			width: 560
			text:  !"# A document

			         Every block becomes an element: a heading is a `RichText` with a role, and this paragraph keeps its markup as runs — **bold**, *slanted*, `code`, ~~struck~~ and [links](https://goi.dev) all draw their own style.

			         ## Lists

			         - a bullet
			         - another, with a nested run
			           - nested items indent
			           - by their depth

			         1. ordered items
			         2. keep the number

			         ## Code and quotes

			         ```go
			         func main() {
			         	fmt.Println("rendered as a Code block")
			         }
			         ```

			         > A quote gets a bar on the left, drawn by a border on the Column that holds it.

			         ---

			         | property | type | notes |
			         |---|---:|---|
			         | text | string | the whole document |
			         | scroll | bool | a long document scrolls its Column |
			         "!
		}
	}
}
