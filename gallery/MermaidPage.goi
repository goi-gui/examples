// Mermaid: the same source a Mermaid.js page renders, drawn by the pure-Go
// renderer. The sources live in the .mmd files beside this page; the component
// keeps the diagram's aspect and follows the app's colour scheme.

Column {
	id:             pageMermaid
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 4
		width:   560

		Text {
			text: "Mermaid"
			role: "titleMedium"
		}

		Text {
			text:  "Thirty-three diagram types, parsed and drawn in Go: no browser, no Node and no network. Each source is a .mmd file beside this page; width scales the diagram and its height follows."
			role:  "bodySmall"
			wrap:  true
			width: 560
		}
	}

	Grid {
		columns: responsive {
			base: 1
			md: 2
		}
		spacing: 16

		Column {
			spacing: 6

			Text {
				text: "Flowchart"
				role: "labelLarge"
			}

			Mermaid {
				width: responsive {
					base: 280
					md: 500
				}
				src:   "goi://flowchart.mmd"
			}
		}

		Column {
			spacing: 6

			Text {
				text: "Sequence"
				role: "labelLarge"
			}

			Mermaid {
				width: responsive {
					base: 280
					md: 500
				}
				src:   "goi://sequence.mmd"
			}
		}

