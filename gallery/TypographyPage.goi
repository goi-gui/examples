// Typography: the M3 type scale, explicit size and weight, style and
// decoration, and text wrapping. Every sample is a Text element, so this page
// is also the visual check for the shaper: the same string in five weights must
// advance differently.

Column {
	id:             pageTypography
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start
	scrollShadow:   true

	// ---------------------------------------------------- type scale
	Column {
		spacing: 4
		width:   520

		Text {
			text: "Type scale"
			role: "titleMedium"
		}

		Text {
			text: "Roles, not sizes"
			role: "displayLarge"
		}

		Text {
			text: "Roles, not sizes"
			role: "displayMedium"
		}

		Text {
			text: "Roles, not sizes"
			role: "displaySmall"
		}

		Text {
			text: "Headline large"
			role: "headlineLarge"
		}

		Text {
			text: "Headline medium"
			role: "headlineMedium"
		}

		Text {
			text: "Headline small"
			role: "headlineSmall"
		}

		Text {
			text: "Title large"
			role: "titleLarge"
		}

		Text {
			text: "Title medium"
			role: "titleMedium"
		}

		Text {
			text: "Title small"
			role: "titleSmall"
		}

		Text {
			text: "Body large. The quick brown fox jumps over the lazy dog."
			role: "bodyLarge"
		}

		Text {
			text: "Body medium. The quick brown fox jumps over the lazy dog."
			role: "bodyMedium"
		}

		Text {
			text: "Body small. The quick brown fox jumps over the lazy dog."
			role: "bodySmall"
		}

		Text {
			text: "Label large"
			role: "labelLarge"
		}

		Text {
			text: "Label medium"
			role: "labelMedium"
		}

		Text {
			text: "Label small"
			role: "labelSmall"
		}
	}

	// -------------------------------------------------------- weights
	Column {
		spacing: 6
		width:   520

		Text {
			text: "Weights"
			role: "titleMedium"
		}

		Text {
			text:     "300 Light — the quick brown fox"
			fontSize: 20
			weight:   300
		}

		Text {
			text:     "400 Regular — the quick brown fox"
			fontSize: 20
			weight:   400
		}

		Text {
			text:     "500 Medium — the quick brown fox"
			fontSize: 20
			weight:   500
		}

		Text {
			text:     "700 Bold — the quick brown fox"
			fontSize: 20
			weight:   700
		}

		Text {
			text:     "900 Black — the quick brown fox"
			fontSize: 20
			weight:   900
		}

		Text {
			text: "Roboto ships in these five weights; 600 or 800 snap to the nearest, so layout and paint still agree."
			role: "bodySmall"
			wrap: true
		}

		// Weight is an override on a role, so one role can carry a heading
		// and its emphasis without a second size.
		Text {
			text:   "Headline small, weight 900"
			role:   "headlineSmall"
			weight: 900
		}

		Text {
			text:   "Body large, weight 300"
			role:   "bodyLarge"
			weight: 300
		}

		Text {
			text:   "Body large, weight 700"
			role:   "bodyLarge"
			weight: 700
		}
	}

	// --------------------------------------------------------- sizes
	Column {
		spacing: 6
		width:   520

		Text {
			text: "Explicit sizes"
			role: "titleMedium"
		}

		Text {
			text:     "11px"
			fontSize: 11
		}

		Text {
			text:     "13px"
			fontSize: 13
		}

		Text {
			text:     "16px"
			fontSize: 16
		}

		Text {
			text:     "21px"
			fontSize: 21
		}

		Text {
			text:     "28px"
			fontSize: 28
		}

		Text {
			text:     "36px"
			fontSize: 36
		}

		Text {
			text:     "48px"
			fontSize: 48
		}

		Text {
			text:     "14px tabular-ish digits: 0123456789"
			fontSize: 14
		}
	}

	// ---------------------------------------------------------- wrap
	Column {
		spacing: 12

		Text {
			text: "Wrapping"
			role: "titleMedium"
		}

		Text {
			text:  "Narrow column, wrapping on. Long paragraphs break at word boundaries and the element reports the height of every line it needs, so the block below stays where it belongs."
			width: 280
			wrap:  true
		}

		Text {
			text: "Above: width 280, wrap true."
			role: "labelMedium"
		}

		Text {
			text:  "Same text with wrap false: it does not break, so it runs past the column and is clipped by the scroll viewport instead."
			width: 280
			wrap:  false
		}

		Text {
			text: "Above: width 280, wrap false."
			role: "labelMedium"
		}

		Text {
			text:  "Wide column, so the same paragraph needs fewer lines and the page reflows around it."
			width: 640
			wrap:  true
		}

		Text {
			text:  "Supercalifragilisticexpialidocious is one word wider than a narrow column, so it is broken between runes rather than overflow."
			width: 180
			wrap:  true
		}

		Text {
			text: "One\nTwo\nThree"
			wrap: true
		}

		Text {
			text: "Above: explicit newlines."
			role: "labelMedium"
		}
	}

	// ----------------------------------------------------------- style
	Column {
		spacing: 12
		width:   520

		Text {
			text: "Style and decoration"
			role: "titleMedium"
		}

		// fontWeight takes the CSS keywords or any number. bolder and
		// lighter are relative to the role's own weight.
		Text {
			text:       "fontWeight: bold"
			fontSize:   20
			fontWeight: bold
		}

		Text {
			text:       "fontWeight: 600 (draws as 700)"
			fontSize:   20
			fontWeight: 600
		}

		Text {
			text:       "fontWeight: bolder than bodyMedium"
			role:       "bodyMedium"
			fontWeight: bolder
		}

		Text {
			text:       "fontWeight: lighter than bodyMedium (300)"
			role:       "bodyMedium"
			fontWeight: lighter
		}

		Text {
			text:      "fontStyle: italic"
			fontSize:  20
			fontStyle: italic
		}

		// A decoration combines the strokes; the style picks how each
		// stroke is drawn.
		Text {
			text:       "underline"
			fontSize:   20
			decoration: underline
		}

		Text {
			text:       "overline"
			fontSize:   20
			decoration: overline
		}

		Text {
			text:       "line-through"
			fontSize:   20
			decoration: line-through
		}

		Text {
			text:       "underline overline"
			fontSize:   20
			decoration: underline overline
		}

		Text {
			text:            "decorationStyle: wavy"
			fontSize:        20
			decoration:      underline
			decorationStyle: wavy
		}

		Text {
			text:            "decorationStyle: dotted"
			fontSize:        20
			decoration:      underline
			decorationStyle: dotted
		}

		Text {
			text:            "decorationStyle: dashed"
			fontSize:        20
			decoration:      underline
			decorationStyle: dashed
		}

		Text {
			text:            "decorationStyle: double"
			fontSize:        20
			decoration:      underline
			decorationStyle: double
		}

		Text {
			text:                "thick red underline"
			fontSize:            20
			decoration:          underline
			decorationThickness: 4
			decorationColor:     #ff0000
		}

		Text {
			text:            "Italic, wavy, primary colour"
			role:            "bodyLarge"
			fontStyle:       italic
			decoration:      underline
			decorationStyle: wavy
			decorationColor: theme.primary
		}
	}

	// ----------------------------------------------------------- shadow
	Column {
		spacing: 12

		Text {
			text: "Shadow"
			role: "titleMedium"
		}

		// Text shadows follow the glyphs, like CSS text-shadow: an
		// offset copy per layer, softened by the blur.
		Text {
			text:   "Soft shadow"
			role:   "displaySmall"
			shadow: 0 4 8 onSurfaceVariant
		}

		Text {
			text:   "Outlined text"
			role:   "displaySmall"
			shadow: -1 0 #000000, 0 1 #000000, 1 0 #000000, 0 -1 #000000
		}

		Text {
			text:   "Glow"
			role:   "displaySmall"
			color:  theme.primary
			shadow: 0 0 12 primary
		}

		// A box shadow borrows box-shadow: offsets, blur, spread and an
		// optional inset, and the first layer is on top.
		Rectangle {
			width:      240
			height:     120
			radius:     16
			background: theme.surfaceContainerHigh
			shadow:     0 2 4 #00000026, 0 12 32 4 #0000001f
		}

		Rectangle {
			width:      240
			height:     120
			radius:     16
			background: theme.surfaceContainerHighest
			shadow:     0 6 16 #00000059 inset
		}
	}

	// -------------------------------------------------------------- row
	Column {
		spacing: 8

		Text {
			text: "Wrapped next to other content"
			role: "titleMedium"
		}

		Row {
			spacing:        16
			crossAxisAlign: start

			Column {
				spacing: 6
				flex:    1

				Text {
					text: "A column with flex takes the remaining space; the paragraph inside wraps to that width instead of the parent's."
					wrap: true
				}

				Text {
					text: "second line of the same block"
					role: "bodySmall"
				}
			}

			Column {
				width:   200
				spacing: 6

				Text {
					text: "Fixed 200dp sidebar with a wrapped note that needs three or four lines."
					wrap: true
				}

				Text {
					text: "sidebar"
					role: "labelSmall"
				}
			}
		}
	}

	Column {
		spacing: 8

		Text {
			text: "Type"
			role: "titleMedium"
		}

		Text {
			text: "Headline medium"
			role: "headlineMedium"
		}

		Text {
			text:   "Title large, weight 900"
			role:   "titleLarge"
			weight: 900
		}

		Text {
			text:   "Body large at 300"
			role:   "bodyLarge"
			weight: 300
		}

		Text {
			text:  "Body medium wraps when the column runs out, and the block reserves one line box for every line it draws. Resize the window to watch it reflow."
			role:  "bodyMedium"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
				lg: 560
			}
		}
	}

	// ---- rich text: one paragraph whose runs differ. The runs are written as
	// Text children and become spans when the page is built.
	Column {
		spacing: 12
		width:   520

		Text {
			text: "Rich text"
			role: "titleMedium"
		}

		RichText {
			role:  "bodyLarge"
			wrap:  true
			width: 100%

			Text {
				text: "Runs come from the file: "
			}

			Text {
				text:       "bold and slanted"
				fontWeight: bold
				fontStyle:  italic
			}

			Text {
				text: ", "
			}

			Text {
				text:       "underlined and struck"
				decoration: underline line-through
			}

			Text {
				text: ", "
			}

			Text {
				text:  "a theme role keeps following the scheme"
				color: tertiary
			}

			Text {
				text: ", and "
			}

			Text {
				text: "this run is a link"
				link: "https://goi.dev"
			}

			Text {
				text: ". They wrap together, so a styled word moves to the next line with the rest of the sentence."
			}
		}
	}

	// ---- emoji: a rune Roboto has no glyph for falls back to Noto Color Emoji,
	// the font Android draws emoji with, so text keeps one line and one size.
	Column {
		spacing: 8

		Text {
			text: "Emoji"
			role: "titleMedium"
		}

		Text {
			text: "Mixed into a line: Hello 😀 👋🏽 🎉"
			role: "bodyLarge"
		}

		Text {
			text:     "Emoji follow the run's size: 28px 😀 🚀 🌍"
			fontSize: 28
		}

		Text {
			text:       "Sequences keep their shape 👨‍👩‍👧‍👦 🏳️‍🌈 👍🏽 ❤️ and flags 🇹🇷 🇯🇵"
			role:       "bodyMedium"
			wrap:       true
			width:      responsive {
				base: 280
				md: 420
			}
			selectable: true
		}

		Text {
			text:  "Noto Color Emoji is embedded, so every emoji draws in colour with no system font and no network."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}
}
