Column {
	id:             pageSurfaces
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Gradients and CSS colours"
			role: "titleMedium"
		}

		Column {
			width:      520
			height:     110
			radius:     16
			background: "linear-gradient(90deg,rgba(42, 123, 155, 1) 0%, rgba(87, 199, 133, 1) 50%, rgba(237, 221, 83, 1) 100%)"
		}

		Column {
			width:      520
			height:     110
			radius:     16
			background: "radial-gradient(circle,rgba(42, 123, 155, 1) 0%, rgba(87, 199, 133, 1) 50%, rgba(237, 221, 83, 1) 100%)"
		}

		Wrap {
			spacing: 8

			Text {
				text:       "white"
				color:      white
				background: black
				padding:    6
				radius:     6
			}

			Text {
				text:    "tomato"
				color:   tomato
				padding: 6
			}

			Text {
				text:    "rebeccapurple"
				color:   rebeccapurple
				padding: 6
			}

			Text {
				text:    "rgb(42, 123, 155)"
				color:   "rgb(42, 123, 155)"
				padding: 6
			}

			Text {
				text:    "hsl(200 40% 50%)"
				color:   "hsl(200 40% 50%)"
				padding: 6
			}

			Text {
				text:    "rgba(0, 0, 0, .5)"
				color:   "rgba(0, 0, 0, .5)"
				padding: 6
			}

			Text {
				text:    "role"
				color:   theme.primary
				padding: 6
			}
		}

		Text {
			text:  "A gradient is a colour value for background; the CSS names, rgb(), rgba(), hsl() and every hex form work anywhere a colour goes."
			role:  "bodySmall"
			wrap:  true
			width: { base: 280, md: 520 }
		}

		Text {
			text: "Rotate"
			role: "titleMedium"
		}

		Row {
			spacing:        24
			crossAxisAlign: center

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     none
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     45deg
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     90deg
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     z 20deg
			}

			Text {
				text:   "turned text"
				role:   "titleMedium"
				rotate: -8deg
			}
		}
	}

	Column {
		spacing: 12

		Text {
			text: "Cards"
			role: "titleMedium"
		}

		Grid {
			columns: { base: 1, md: 2, lg: 3 }
			spacing: 12

			Card {
				label:      "Elevated"
				supporting: "Surface container low"
				height:     96
			}

			Card {
				label:      "Filled"
				supporting: "Highest container"
				variant:    filled
				height:     96
			}

			Card {
				label:      "Outlined"
				supporting: "1dp outline"
				variant:    outlined
				height:     96
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Carousel"
			role: "titleMedium"
		}

		Carousel {
			height: 200
			gap:    10

			Card {
				width:      220
				label:      "One"
				supporting: "Scroll sideways"
				variant:    filled
			}

			Card {
				width:      220
				label:      "Two"
				supporting: "Drag or use the wheel"
			}

			Card {
				width:      220
				label:      "Three"
				supporting: "The strip clips"
				variant:    outlined
			}

			Card {
				width:      220
				label:      "Four"
				supporting: "Last item"
				variant:    filled
			}
		}

		Text {
			text: "A horizontally scrolling strip: the wheel over it moves it sideways."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "List"
			role: "titleMedium"
		}

		List {
			width: { base: 100%, md: 420 }

			ListItem {
				label:        "List item"
				icon:         person
				trailingIcon: chevron_right
			}

			ListItem {
				label:      "Two lines"
				supporting: "Supporting text"
				icon:       photo
			}

			Divider {}

			ListItem {
				label:    "Selected"
				icon:     star
				selected: true
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Tabs"
			role: "titleMedium"
		}

		Tabs {
			width: { base: 100%, md: 420 }

			Tab {
				label:    "Overview"
				selected: true
			}

			Tab {
				label: "Specs"
			}

			Tab {
				label: "Details"
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Menu"
			role: "titleMedium"
		}

		Menu {
			width: 260

			MenuItem {
				label: "Cut"
				icon:  content_cut
			}

			MenuItem {
				label: "Copy"
				icon:  content_copy
			}

			MenuItem {
				label: "Paste"
				icon:  content_paste
			}

			Divider {}

			MenuItem {
				label: "More…"
				icon:  more_horiz
			}
		}
	}
}
