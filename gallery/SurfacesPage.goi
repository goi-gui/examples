Column {
	id:             pageSurfaces
	visible:        false
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Gradients and CSS colours"
			role: "titleMedium"
		}

		Column {
			width:      responsive {
				base: 100%
				sm: 520
			}
			height:     110
			radius:     16
			background: "linear-gradient(90deg,rgba(42, 123, 155, 1) 0%, rgba(87, 199, 133, 1) 50%, rgba(237, 221, 83, 1) 100%)"
		}

		Column {
			width:      responsive {
				base: 100%
				sm: 520
			}
			height:     110
			radius:     16
			background: "radial-gradient(circle,rgba(42, 123, 155, 1) 0%, rgba(87, 199, 133, 1) 50%, rgba(237, 221, 83, 1) 100%)"
		}

		// A stop may be a colour variable, so a gradient follows the scheme.
		Column {
			width:      responsive {
				base: 100%
				sm: 520
			}
			height:     110
			radius:     16
			background: "linear-gradient(90deg, theme.primary, theme.tertiary 60%, theme.secondary)"
		}

		Wrap {
			spacing: 8

			Text {
				text:       "white"
				color:      white
				background: black
				padding:    6
				radius:     6
			}

			Text {
				text:    "tomato"
				color:   tomato
				padding: 6
			}

			Text {
				text:    "rebeccapurple"
				color:   rebeccapurple
				padding: 6
			}

			Text {
				text:    "rgb(42, 123, 155)"
				color:   "rgb(42, 123, 155)"
				padding: 6
			}

			Text {
				text:    "hsl(200 40% 50%)"
				color:   "hsl(200 40% 50%)"
				padding: 6
			}

			Text {
				text:    "rgba(0, 0, 0, .5)"
				color:   "rgba(0, 0, 0, .5)"
				padding: 6
			}

			Text {
				text:    "role"
				color:   theme.primary
				padding: 6
			}
		}

		Text {
			text:  "A gradient is a colour value for background; a stop may be a literal or a variable such as theme.primary, and a shadow colour names its namespace too: theme.primary or customColor.brand."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 520
			}
		}
	}

	Column {
		spacing: 12

		Text {
			text: "Cards"
			role: "titleMedium"
		}

		Grid {
			columns: responsive {
				base: 1
				md: 2
				lg: 3
			}
			spacing: 12

			Card {
				label:      "Elevated"
				supporting: "Surface container low"
				height:     96
			}

			Card {
				label:      "Filled"
				supporting: "Highest container"
				variant:    filled
				height:     96
			}

			Card {
				label:      "Outlined"
				supporting: "1dp outline"
				variant:    outlined
				height:     96
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Carousel"
			role: "titleMedium"
		}

		Carousel {
			height: 200
			gap:    10

			Card {
				width:      220
				label:      "One"
				supporting: "Scroll sideways"
			}

			Card {
				width:      220
				label:      "Two"
				supporting: "Drag or use the wheel"
			}

			Card {
				width:      220
				label:      "Three"
				supporting: "The strip clips"
			}

			Card {
				width:      220
				label:      "Four"
				supporting: "Last item"
			}
		}

		Text {
			text: "A horizontally scrolling strip: the wheel over it moves it sideways."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "List"
			role: "titleMedium"
		}

		List {
			width: responsive {
				base: 100%
				md: 420
			}

			ListItem {
				label:        "List item"
				leadingIcon:  person
				trailingIcon: chevron_right
			}

			ListItem {
				label:       "Two lines"
				supporting:  "Supporting text"
				leadingIcon: photo
			}

			Divider {}

			ListItem {
				label:       "Selected"
				leadingIcon: star
				selected:    true
			}

			ListItem {
				label:            "Tinted"
				supporting:       "Each part has its own colour"
				leadingIcon:      favorite
				leadingIconColor: theme.tertiary
				labelColor:       theme.primary
				supportingColor:  theme.secondary
			}

			// A body instead of an icon: the slot is centred in the icon square.
			ListItem {
				label:      "Slots"
				supporting: "An avatar and a switch"

				$leading {
					Rectangle {
						width:      32
						height:     32
						radius:     16
						background: theme.primaryContainer
					}
				}

				$trailing {
					Switch {
						checked: true
					}
				}
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Tabs"
			role: "titleMedium"
		}

		Tabs {
			width: responsive {
				base: 100%
				md: 420
			}

			Tab {
				label:    "Overview"
				selected: true
			}

			Tab {
				label: "Specs"
			}

			Tab {
				label: "Details"
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Menu"
			role: "titleMedium"
		}

		Menu {
			width: 260

			MenuItem {
				label:       "Cut"
				leadingIcon: content_cut
			}

			MenuItem {
				label:       "Copy"
				leadingIcon: content_copy
			}

			MenuItem {
				label:       "Paste"
				leadingIcon: content_paste
			}

			Divider {}

			MenuItem {
				label:       "More…"
				leadingIcon: more_horiz
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Popover"
			role: "titleMedium"
		}

		// The panel floats out of the flow, so the box reserves room for it.
		Column {
			crossAxisAlign: start

			Popover {
				align: start

				SplitButton {
					id:           splitPopover
					label:        "Share"
					leadingIcon:  share
					trailingIcon: splitPopover.expanded ? arrow_drop_up : arrow_drop_down
					onClick:      splitPopover.expand()
				}

				$popover {
					Card {
						visible:         splitPopover.expanded
						label:           "Anyone with the link"
						supporting:      "Link sharing is on"
						width:           260
						height:          96
						borderThickness: 1
						borderColor:     theme.primary
					}
				}
			}
		}
	}

	// ---- theme: the same switch as the one at the bottom of the
	// rail. Both drive one piece of app state.
	Column {
		spacing: 8

		Text {
			text: "Theme"
			role: "titleMedium"
		}

		Switch {
			id:    darkSwitch
			label: "Dark mode"
			width: 220
		}

		Text {
			text:  "Every colour comes from the M3 scheme, so the whole page follows: surfaces, text, icons and state layers."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}
}
