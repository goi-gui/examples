// Media: images, video and audio.
//
// A GIF, an APNG or an SVG with a SMIL animation plays on its own; `loop`,
// `paused` and the play/pause/stop methods are the transport a design or Go
// drives. Video and audio decode through ffmpeg and share the same control bar;
// the video here also shows an SRT caption.

Column {
	id:             pageMedia
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Bitmap"
			role: "titleMedium"
		}

		Wrap {
			spacing: 12

			// cover crops to fill the box; contain letterboxes.
			Image {
				src:    "goi://sample.jpg"
				width:  180
				height: 120
				radius: 12
			}

			Image {
				src:        "goi://sample.jpg"
				fit:        contain
				width:      180
				height:     120
				radius:     12
				background: theme.surfaceContainerHigh
			}

			Image {
				src:    "goi://sample.jpg"
				fit:    fill
				width:  180
				height: 120
				radius: 12
			}

			// No src: Go supplies the bitmap with SetImage.
			Image {
				id:          generated
				width:       180
				height:      120
				radius:      12
				fit:         cover
				borderColor: theme.primary
				borderWidth: 1
			}
		}

		Text {
			text:  "PNG, JPEG and GIF, decoded once and packed into one GPU atlas. fit picks cover, contain or fill. The last one is drawn in Go with SetImage, so it needs no file."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Animated GIF and APNG"
			role: "titleMedium"
		}

		Row {
			spacing:        16
			crossAxisAlign: center

			Image {
				id:     gifImage
				src:    "goi://pulse.gif"
				width:  72
				height: 72
			}

			Image {
				id:     apngImage
				src:    "goi://pulse.png"
				width:  72
				height: 72
			}
		}

		Text {
			text:  "Both loop by default. `loop: false` plays one pass and holds the last frame, and `paused: true` starts held; play, pause and stop move them from Go or from an event."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "SVG"
			role: "titleMedium"
		}

		Row {
			spacing:        16
			crossAxisAlign: center

			// currentColor takes the design's colour, so one file serves every
			// theme role.
			SVG {
				src:    "goi://star.svg"
				color:  theme.primary
				width:  48
				height: 48
			}

			SVG {
				src:    "goi://star.svg"
				color:  theme.tertiary
				width:  48
				height: 48
			}

			// A real exported icon: its colours live in a stylesheet (class +
			// var(--indicator)) and its shape morphs, so both the CSS reader and
			// path interpolation are exercised here.
			SVG {
				id:     loadingSVG
				src:    "goi://loading.svg"
				width:  56
				height: 56
				color:  theme.primary
			}

			// A SMIL animation: the arc turns and the stroke shifts colour,
			// both declared in the file.
			SVG {
				id:     spinSVG
				src:    "goi://spinner.svg"
				width:  56
				height: 56
			}
		}

		Text {
			text:  "A <animate> or <animateTransform> in the document plays on its own; loop and paused behave the same as on an Image."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Transport"
			role: "titleMedium"
		}

		Text {
			text:  "The three buttons call the clips by id from the design itself; the switch is wired in Go and drives all of them."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Row {
			spacing: 8

			Button {
				label:   "Play"
				variant: tonal
				onClick: gifImage.play()
			}

			Button {
				label:   "Pause"
				variant: tonal
				onClick: gifImage.pause()
			}

			Button {
				label:   "Stop"
				variant: tonal
				onClick: gifImage.stop()
			}

			Button {
				label:   "Play SVG"
				variant: text
				onClick: spinSVG.play()
			}

			Button {
				label:   "Pause SVG"
				variant: text
				onClick: spinSVG.pause()
			}

			Button {
				label:   "Stop SVG"
				variant: text
				onClick: spinSVG.stop()
			}
		}

		Row {
			spacing:        16
			crossAxisAlign: center

			Switch {
				id:      animPause
				label:   "Pause all (Go)"
				checked: false
			}

			Switch {
				id:      animLoop
				label:   "Loop (Go)"
				checked: true
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Video"
			role: "titleMedium"
		}

		Video {
			id:        clip
			width:     responsive {
				base: 280
				md: 480
			}
			height:    240
			src:       "goi://clip.mp4"
			subtitles: "goi://clip.srt"
			controls:  true
			loop:      true
		}

		Text {
			text:  "A frame into the same atlas an image uses, with a bar that hides after three idle seconds. The SRT file above is drawn over the picture."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 480
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Audio"
			role: "titleMedium"
		}

		Audio {
			id:       podcast
			width:    responsive {
				base: 280
				md: 420
			}
			height:   64
			src:      "goi://clip.mp4"
			controls: true
		}

		Audio {
			width:        responsive {
				base: 280
				md: 420
			}
			height:       64
			src:          "goi://clip.mp4"
			controls:     true
			variant:      wavy
			color:        theme.tertiary
			surfaceColor: theme.surfaceContainerHighest
		}

		Text {
			text:  "The same file as the video; the second bar is the wavy variant with its own track colour. An audio bar stays while a video's hides."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}
}
