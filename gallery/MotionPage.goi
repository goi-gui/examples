Column {
	id:             pageMotion
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Easing"
			role: "titleMedium"
		}

		Text {
			text:  "One distance, three curves. Linear keeps a constant speed, Standard starts fast and lands soft, Emphasized is slow at both ends. Press Play to run them together."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Column {
			width:   300
			spacing: 14

			Column {
				spacing: 4

				Text {
					text: "Linear"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotLinear
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}

			Column {
				spacing: 4

				Text {
					text: "Standard"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotStandard
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}

			Column {
				spacing: 4

				Text {
					text: "Emphasized"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotEmphasized
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}
		}

		Button {
			id:    playEasing
			label: "Play"
			icon:  play_arrow
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Value"
			role: "titleMedium"
		}

		Text {
			text:  "app.Animate moves any numeric Prop, so a slider and a progress ring follow the same tween without a special animation API."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Row {
			spacing: 24

			Slider {
				id:    motionSlider
				value: 0.25
				width: 240
			}

			CircularProgress {
				id:     motionProgress
				value:  0.3
				width:  64
				height: 64
			}
		}

		Button {
			id:      playValue
			label:   "Animate value"
			icon:    play_arrow
			variant: tonal
		}
	}
}
