bridge {
	people []person
}

type person {
	name string
	role string
	team string
	age  int
}

Column {
	id:             pageTable
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 8

		Text {
			text: "Team directory"
			role: "titleMedium"
		}

		Text {
			text:  "A sortable header shows a hand and an arrow. This table is selectable: multiple, so each click adds a row and clicking a selected row drops it. SortBy and SetSelectedRows do the same from Go."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Row {
		spacing: 8

		Button {
			id:      tableSortName
			label:   "Sort by name"
			variant: tonal
		}

		Button {
			id:      tableSortAge
			label:   "Sort by age, descending"
			variant: tonal
		}

		Button {
			id:      tableClearSort
			label:   "Declaration order"
			variant: text
		}

		Button {
			id:      tableSelectFirstTwo
			label:   "Select first two"
			variant: text
		}
	}

	Table {
		id:         tablePeople
		width:      100%
		striped:    true
		selectable: multiple

		TableColumn {
			key:      "name"
			label:    "Name"
			icon:     person
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "role"
			label:    "Role"
			icon:     type_specimen
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "team"
			label:    "Team"
			icon:     group
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "age"
			label:    "Age"
			icon:     cake
			width:    25%
			numeric:  true
			sortable: true
		}

		for i, p := range bridge.people {
			TableRow {
				TableCell {
					value: p.name

					Text {
						text: p.name
					}
				}

				TableCell {
					value: p.role

					Text {
						text: p.role
					}
				}

				TableCell {
					value: p.team

					Text {
						text: p.team
					}
				}

				TableCell {
					value: formatf("%d", p.age)

					Text {
						text: formatf("%d", p.age)
					}
				}
			}
		}
	}

	Text {
		id:   tableSorted
		text: "declaration order"
		role: "labelMedium"
	}

	Text {
		id:   tableSelected
		text: "no row selected"
		role: "labelMedium"
	}

	// ---- variants
	Column {
		spacing: 8

		Text {
			text: "Variants"
			role: "titleMedium"
		}

		Text {
			text:  "Outlined (the default), filled and plain. Only these three are accepted, because they are the styles the painter has."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Row {
		width:   100%
		spacing: 16

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "outlined"
				role: "labelMedium"
			}

			Table {
				width: 100%

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						value: "Build"

						Text {
							text: "Build"
						}
					}

					TableCell {
						value: "passing"

						Text {
							text: "passing"
						}
					}
				}

				TableRow {
					TableCell {
						value: "Tests"

						Text {
							text: "Tests"
						}
					}

					TableCell {
						value: "128"

						Text {
							text: "128"
						}
					}
				}
			}
		}

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "filled"
				role: "labelMedium"
			}

			Table {
				width:   100%
				variant: filled

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						value: "Build"

						Text {
							text: "Build"
						}
					}

					TableCell {
						value: "passing"

						Text {
							text: "passing"
						}
					}
				}

				TableRow {
					TableCell {
						value: "Tests"

						Text {
							text: "Tests"
						}
					}

					TableCell {
						value: "128"

						Text {
							text: "128"
						}
					}
				}
			}
		}

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "plain"
				role: "labelMedium"
			}

			Table {
				width:   100%
				variant: plain

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						value: "Build"

						Text {
							text: "Build"
						}
					}

					TableCell {
						value: "passing"

						Text {
							text: "passing"
						}
					}
				}

				TableRow {
					TableCell {
						value: "Tests"

						Text {
							text: "Tests"
						}
					}

					TableCell {
						value: "128"

						Text {
							text: "128"
						}
					}
				}
			}
		}
	}

	// ---- a cell holds children, so it can show anything.
	Column {
		spacing: 8

		Text {
			text: "Cell content"
			role: "titleMedium"
		}

		Text {
			text:  "A TableCell's children are what the row shows; value is only the string sorting reads, so a formatted date can sort by its ISO key."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Table {
		width: 100%

		TableColumn {
			label:    "Release"
			width:    30%
			sortable: true
		}

		TableColumn {
			label:    "Date"
			width:    25%
			sortable: true
		}

		TableColumn {
			label: "State"
			width: 45%
		}

		TableRow {
			TableCell {
				value: "v0.5.1"

				Text {
					text: "v0.5.1"
				}
			}

			TableCell {
				value: "2026-11-08"

				Text {
					text: "8 Nov 2026"
				}
			}

			TableCell {
				value: "shipped"

				Row {
					spacing:        8
					crossAxisAlign: center

					Chip {
						label:    "shipped"
						variant:  input
						selected: true
					}
				}
			}
		}

		TableRow {
			TableCell {
				value: "v0.5.0"

				Text {
					text: "v0.5.0"
				}
			}

			TableCell {
				value: "2026-08-01"

				Text {
					text: "1 Aug 2026"
				}
			}

			TableCell {
				value: "shipped"

				Row {
					spacing:        8
					crossAxisAlign: center

					Chip {
						label:   "shipped"
						variant: input
					}
				}
			}
		}

		TableRow {
			TableCell {
				value: "v0.6.0"

				Text {
					text: "v0.6.0"
				}
			}

			TableCell {
				value: "2026-12-25"

				Text {
					text: "25 Dec 2026"
				}
			}

			TableCell {
				value: "planned"

				Row {
					spacing:        8
					crossAxisAlign: center

					Chip {
						label:   "planned"
						variant: assist
					}
				}
			}
		}
	}

	// ---- chrome off: no header, short rows, no surface, inert cells.
	Column {
		spacing: 8

		Text {
			text: "Recent activity"
			role: "titleMedium"
		}

		Text {
			text:  "The same component with variant: plain, showHeader: false, rowHeight: 36 and selectable: none, so its rows are inert."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Table {
		variant:    plain
		showHeader: false
		rowHeight:  36
		selectable: none

		TableColumn {
			width: 260
		}

		TableColumn {
			width: 160
		}

		TableRow {
			TableCell {
				value: "Build passed on linux/amd64"
				icon:  check_circle

				Text {
					text: "Build passed on linux/amd64"
				}
			}

			TableCell {
				value: "2 minutes ago"

				Text {
					text: "2 minutes ago"
				}
			}
		}

		TableRow {
			TableCell {
				value: "Release v0.5.1 published"
				icon:  cloud_upload

				Text {
					text: "Release v0.5.1 published"
				}
			}

			TableCell {
				value: "1 hour ago"

				Text {
					text: "1 hour ago"
				}
			}
		}

		TableRow {
			TableCell {
				value: "Two tests skipped"
				icon:  warning

				Text {
					text: "Two tests skipped"
				}
			}

			TableCell {
				value: "yesterday"

				Text {
					text: "yesterday"
				}
			}
		}
	}
}
