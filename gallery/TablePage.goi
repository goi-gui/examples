bridge {
	people []person
}

type person {
	name string
	role string
	team string
	age  int
}

Column {
	id:             pageTable
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 8

		Text {
			text: "Team directory"
			role: "titleMedium"
		}

		Text {
			text:  "A sortable header shows a hand and an arrow. This table is selectable: multiple, so each click adds a row and clicking a selected row drops it. SortBy and SetSelectedRows do the same from Go."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Row {
		spacing: 8

		Button {
			id:      tableSortName
			label:   "Sort by name"
			variant: tonal
		}

		Button {
			id:      tableSortAge
			label:   "Sort by age, descending"
			variant: tonal
		}

		Button {
			id:      tableClearSort
			label:   "Declaration order"
			variant: text
		}

		Button {
			id:      tableSelectFirstTwo
			label:   "Select first two"
			variant: text
		}
	}

	Table {
		id:         tablePeople
		width:      100%
		striped:    true
		selectable: multiple

		TableColumn {
			key:      "name"
			label:    "Name"
			icon:     person
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "role"
			label:    "Role"
			icon:     type_specimen
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "team"
			label:    "Team"
			icon:     group
			width:    25%
			sortable: true
		}

		TableColumn {
			key:      "age"
			label:    "Age"
			icon:     cake
			width:    25%
			numeric:  true
			sortable: true
		}

		for i, p := range bridge.people {
			TableRow {
				TableCell {
					text: p.name
				}

				TableCell {
					text: p.role
				}

				TableCell {
					text: p.team
				}

				TableCell {
					text: formatf("%d", p.age)
				}
			}
		}
	}

	Text {
		id:   tableSorted
		text: "declaration order"
		role: "labelMedium"
	}

	Text {
		id:   tableSelected
		text: "no row selected"
		role: "labelMedium"
	}

	// ---- variants
	Column {
		spacing: 8

		Text {
			text: "Variants"
			role: "titleMedium"
		}

		Text {
			text:  "Outlined (the default), filled and plain. Only these three are accepted, because they are the styles the painter has."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Row {
		width:   100%
		spacing: 16

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "outlined"
				role: "labelMedium"
			}

			Table {
				width: 100%

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						text: "Build"
					}

					TableCell {
						text: "passing"
					}
				}

				TableRow {
					TableCell {
						text: "Tests"
					}

					TableCell {
						text: "128"
					}
				}
			}
		}

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "filled"
				role: "labelMedium"
			}

			Table {
				width:   100%
				variant: filled

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						text: "Build"
					}

					TableCell {
						text: "passing"
					}
				}

				TableRow {
					TableCell {
						text: "Tests"
					}

					TableCell {
						text: "128"
					}
				}
			}
		}

		Column {
			flex:    1
			spacing: 6

			Text {
				text: "plain"
				role: "labelMedium"
			}

			Table {
				width:   100%
				variant: plain

				TableColumn {
					label: "Item"
					width: 50%
				}

				TableColumn {
					label: "State"
					width: 50%
				}

				TableRow {
					TableCell {
						text: "Build"
					}

					TableCell {
						text: "passing"
					}
				}

				TableRow {
					TableCell {
						text: "Tests"
					}

					TableCell {
						text: "128"
					}
				}
			}
		}
	}

	// ---- chrome off: no header, short rows, no surface, inert cells.
	Column {
		spacing: 8

		Text {
			text: "Recent activity"
			role: "titleMedium"
		}

		Text {
			text:  "The same component with variant: plain, showHeader: false, rowHeight: 36 and selectable: none, so its rows are inert."
			role:  "bodySmall"
			wrap:  true
			width: 100%
		}
	}

	Table {
		variant:    plain
		showHeader: false
		rowHeight:  36
		selectable: none

		TableColumn {
			width: 260
		}

		TableColumn {
			width: 160
		}

		TableRow {
			TableCell {
				text: "Build passed on linux/amd64"
				icon: check_circle
			}

			TableCell {
				text: "2 minutes ago"
			}
		}

		TableRow {
			TableCell {
				text: "Release v0.5.1 published"
				icon: cloud_upload
			}

			TableCell {
				text: "1 hour ago"
			}
		}

		TableRow {
			TableCell {
				text: "Two tests skipped"
				icon: warning
			}

			TableCell {
				text: "yesterday"
			}
		}
	}
}
