Column {
	id:             pageFeedback
	visible:        false
	scroll:         true
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Progress"
			role: "titleMedium"
		}

		LinearProgress {
			value: 0.6
			width: responsive {
				base: 280
				md: 420
			}
		}

		// The wavy variant is a ribbon: the same progress, drawn as a wave that
		// keeps the track's stop dot at the end.
		LinearProgress {
			variant: wavy
			value:   0.6
			width:   responsive {
				base: 280
				md: 420
			}
		}

		Row {
			spacing:        24
			crossAxisAlign: center

			CircularProgress {
				value: 0.65
			}

			CircularProgress {
				variant: wavy
				value:   0.65
			}

			LoadingIndicator {
				size:  24
				color: theme.tertiary
			}

			LoadingIndicator {
				size: 48
			}

			LoadingIndicator {
				size:  72
				color: theme.secondary
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Badges"
			role: "titleMedium"
		}

		Wrap {
			spacing: 16

			Badge {}

			Badge {
				label: "12"
			}

			Badge {
				label: "99+"
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Dialog and sheets"
			role: "titleMedium"
		}

		Wrap {
			spacing: 16

			Dialog {
				label:      "Reset settings?"
				supporting: "This cannot be undone."
				width:      280
				height:     168
			}

			Column {
				spacing: 12

				BottomSheet {
					label:  "Bottom sheet"
					width:  280
					height: 132
				}

				SideSheet {
					label:  "Side sheet"
					width:  280
					height: 132
				}
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Snackbar and tooltip"
			role: "titleMedium"
		}

		Snackbar {
			label: "Saved to your library"
			width: responsive {
				base: 280
				md: 420
			}
		}

		Tooltip {
			text: "Saves to your library"

			Button {
				label: "Hover me"
				icon:  save
			}
		}
	}
}
