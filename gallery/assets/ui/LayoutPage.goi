bridge {
	rows []galleryRow
}

type galleryRow {
	title      string
	supporting string
}

Column {
	id:             pageLayout
	visible:        false
	spacing:        24
	padding:        20
	crossAxisAlign: start

	// ---- axes: crossAxisAlign across, mainAxisAlign along.
	Column {
		spacing: 8

		Text {
			text: "Alignment axes"
			role: "titleMedium"
		}

		Text {
			text:  "crossAxisAlign places a child across the flow; mainAxisAlign places the run along it. Both default to start."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Row {
			id:             axisRow
			width:          responsive {
				base: 280
				md: 420
			}
			height:         56
			spacing:        8
			crossAxisAlign: center
			mainAxisAlign:  spaceBetween

			Rectangle {
				width:      40
				height:     40
				radius:     8
				background: theme.primary
			}

			Rectangle {
				width:      40
				height:     24
				radius:     8
				background: theme.secondary
			}

			Rectangle {
				width:      40
				height:     32
				radius:     8
				background: theme.tertiary
			}
		}

		Column {
			width:          responsive {
				base: 280
				md: 420
			}
			height:         96
			spacing:        6
			crossAxisAlign: center
			mainAxisAlign:  spaceAround

			Rectangle {
				width:      90
				height:     20
				radius:     6
				background: theme.primaryContainer
			}

			Rectangle {
				width:      60
				height:     20
				radius:     6
				background: theme.secondaryContainer
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Title bar"
			role: "titleMedium"
		}

		// The same design can carry both platforms: app.os picks
		// one at runtime. Here they are plain rows inside the
		// page; with titleBar: custom on the Window, a TitleBar
		// also drags the window and the outer edge resizes it.
		TitleBar {
			height:         40
			paddingLeft:    12
			paddingRight:   4
			spacing:        4
			crossAxisAlign: center
			background:     theme.surfaceContainerHigh
			radius:         8

			Text {
				text: "Linux and Windows Custom Titlebar"
				role: "labelMedium"
			}

			Rectangle {
				flex: 1
			}

			IconButton {
				icon:    remove
				variant: text
				size:    32
			}

			IconButton {
				icon:    crop_square
				variant: text
				size:    32
			}

			IconButton {
				icon:    close
				variant: text
				size:    32
			}
		}

		TitleBar {
			height:         40
			paddingLeft:    12
			paddingRight:   12
			spacing:        4
			crossAxisAlign: center
			background:     theme.surfaceContainerHigh
			radius:         8
			gap:            10

			Row {
				gap:            10
				crossAxisAlign: center

				Rectangle {
					width:           18
					height:          18
					background:      #fc5753
					borderColor:     #df4744
					borderThickness: 2
					radius:          10
				}

				Rectangle {
					width:           18
					height:          18
					background:      #fdbc40
					borderColor:     #dea035
					borderThickness: 2
					radius:          10
				}

				Rectangle {
					width:           18
					height:          18
					background:      #36c84b
					borderColor:     #27aa35
					borderThickness: 2
					radius:          10
				}
			}

			Text {
				text: "macOS Custom Titlebar"
				role: "labelMedium"
			}
		}

		Text {
			text:  "visible: app.os == \"linux\" picks a bar per platform; only one of the two above exists at runtime."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 460
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Toolbar"
			role: "titleMedium"
		}

		Toolbar {
			spacing: 4

			IconButton {
				icon: undo
			}

			IconButton {
				icon: redo
			}

			Divider {
				height:      24
				marginLeft:  6
				marginRight: 6
			}

			IconButton {
				icon: format_bold
			}

			IconButton {
				icon: format_italic
			}

			IconButton {
				icon: format_underlined
			}

			Divider {
				height:      24
				marginLeft:  6
				marginRight: 6
			}

			IconButton {
				icon: share
			}
		}

		Text {
			text: "A floating row of actions in one pill."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 12

		Text {
			text: "ClipRRect"
			role: "titleMedium"
		}

		Row {
			spacing: 12

			ClipRRect {
				radius: 24
				width:  96
				height: 96

				Rectangle {
					background: theme.primary
				}

				// The strip runs past the box and is cut at the
				// rounded edge, which is the whole point.
				Rectangle {
					width:      200
					height:     20
					marginTop:  60
					background: theme.tertiary
				}
			}

			ClipRRect {
				radius: 8
				width:  96
				height: 96

				Image {
					src: "goi://images/sample.jpg"
					fit: cover
				}
			}

			ClipRRect {
				radius: 48
				width:  96
				height: 96

				Image {
					src: "goi://images/sample.jpg"
					fit: cover
				}
			}
		}

		Text {
			text:  "radius rounds the cut; a child wider than the box is clipped, not scaled."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 460
			}
		}
	}

	Column {
		spacing: 12

		Text {
			text: "Grid"
			role: "titleMedium"
		}

		Grid {
			columns: responsive {
				base: 1
				sm: 2
				lg: 3
			}
			spacing: 12

			Card {
				label:      "One"
				supporting: "base: 1 column"
				height:     88
				variant:    filled
			}

			Card {
				label:      "Two"
				supporting: "sm: 2 columns"
				height:     88
			}

			Card {
				label:      "Three"
				supporting: "lg: 3 columns"
				height:     88
				variant:    outlined
			}
		}
	}

	Column {
		spacing: 12

		Text {
			text: "Masonry grid"
			role: "titleMedium"
		}

		Grid {
			columns: 3
			spacing: 12
			variant: masonry

			Rectangle {
				width:      100%
				height:     96
				radius:     12
				background: theme.primaryContainer
			}

			Rectangle {
				width:      100%
				height:     164
				radius:     12
				background: theme.tertiaryContainer
			}

			Rectangle {
				width:      100%
				height:     128
				radius:     12
				background: theme.secondaryContainer
			}

			Rectangle {
				width:      100%
				height:     72
				radius:     12
				background: theme.surfaceContainerHighest
			}

			Rectangle {
				width:      100%
				height:     140
				radius:     12
				background: theme.primaryContainer
			}
		}

		Text {
			text: "Each box keeps its own height and takes the shortest column, so the page packs without ragged gaps."
			role: "bodySmall"
			wrap: true
		}
	}

	Column {
		spacing: 12

		Text {
			text: "AspectRatio"
			role: "titleMedium"
		}

		Row {
			spacing:        12
			crossAxisAlign: start

			AspectRatio {
				width:       240
				aspectRatio: 1.7777
				radius:      12
				background:  theme.surfaceContainerHigh

				Text {
					text: "16:9"
					role: "labelLarge"
				}
			}

			AspectRatio {
				width:       120
				aspectRatio: 1
				radius:      12
				background:  theme.tertiaryContainer

				Text {
					text: "1:1"
					role: "labelLarge"
				}
			}

			AspectRatio {
				width:       96
				aspectRatio: 0.75
				radius:      12
				background:  theme.secondaryContainer

				Text {
					text: "3:4"
					role: "labelLarge"
				}
			}
		}

		Text {
			text: "The width is declared and the height follows the ratio; in a Row, the height would come from the parent instead."
			role: "bodySmall"
			wrap: true
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Wrap"
			role: "titleMedium"
		}

		Wrap {
			spacing: 8

			Chip {
				label:       "Wrap"
				leadingIcon: event
			}

			Chip {
				label: "Second"
			}

			Chip {
				label: "Third"
			}

			Chip {
				label: "Fourth"
			}

			Chip {
				label: "Fifth"
			}

			Chip {
				label: "Sixth"
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Stack and positioned"
			role: "titleMedium"
		}

		Stack {
			width:  responsive {
				base: 280
				md: 420
			}
			height: 200

			// A Card rather than a coloured Rectangle: the plate
			// has to follow the theme, and a Card is the M3
			// surface that does.
			Card {
				variant: filled
				radius:  16
			}

			Positioned {
				left: 16
				top:  16

				Card {
					label:      "left: 16"
					supporting: "top: 16"
					width:      190
					height:     84
					variant:    filled
				}
			}

			Positioned {
				right:  16
				bottom: 16

				Chip {
					label:       "bottom right"
					leadingIcon: star
				}
			}

			Positioned {
				left:       16
				right:      16
				bottom:     64
				height:     4
				background: theme.primary
				radius:     2
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "zIndex"
			role: "titleMedium"
		}

		Text {
			text:  "zIndex orders siblings when painting, like CSS. Higher paints last, so it lands on top; layout never moves."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Stack {
			width:  responsive {
				base: 280
				md: 420
			}
			height: 140

			// First in the file, but zIndex 2 paints it last, above the card
			// that follows it.
			Positioned {
				left: 0
				top:  0

				Card {
					label:      "zIndex: 2"
					supporting: "on top"
					width:      200
					height:     80
					variant:    filled
					zIndex:     2
				}
			}

			Positioned {
				left: 60
				top:  40

				Card {
					label:      "zIndex: 1"
					supporting: "behind"
					width:      200
					height:     80
					variant:    filled
					zIndex:     1
				}
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Rotate"
			role: "titleMedium"
		}

		Row {
			spacing:        24
			crossAxisAlign: center

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     none
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     45deg
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     90deg
			}

			Column {
				width:      80
				height:     56
				radius:     8
				background: theme.primaryContainer
				rotate:     z 20deg
			}

			Text {
				text:   "turned text"
				role:   "titleMedium"
				rotate: -8deg
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Scale"
			role: "titleMedium"
		}

		Text {
			text: "Layout keeps every box where it was; only the paint stretches."
			role: "bodySmall"
			wrap: true
		}

		Row {
			spacing:        36
			crossAxisAlign: center

			Column {
				width:      60
				height:     36
				radius:     8
				background: theme.secondaryContainer
				scale:      none
			}

			Column {
				width:      60
				height:     36
				radius:     8
				background: theme.secondaryContainer
				scale:      1.5
			}

			Column {
				width:      60
				height:     36
				radius:     8
				background: theme.secondaryContainer
				scale:      0.5
			}

			Column {
				width:      60
				height:     36
				radius:     8
				background: theme.secondaryContainer
				scale:      1.6 0.6
			}
		}

		Text {
			text:  "scaled text"
			role:  "titleMedium"
			scale: 1.4
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Expressions"
			role: "titleMedium"
		}

		Column {
			width:   320
			spacing: 8

			// Named roles instead of hex: these follow the scheme.
			Rectangle {
				id:         demoBase
				width:      240
				height:     10
				background: theme.primary
				radius:     5
			}

			Rectangle {
				width:      demoBase.width / 2
				height:     10
				background: theme.secondary
				radius:     5
			}

			Rectangle {
				width:      50%
				height:     10
				background: theme.tertiary
				radius:     5
			}
		}

		Column {
			spacing: 6

			Text {
				text: "Conditional: the " + app.mode + " scheme is active."
				role: "bodyMedium"
			}

			Rectangle {
				width:      160
				height:     8
				radius:     4
				background: app.dark ? primaryContainer : inversePrimary
			}
		}

		Text {
			text: "A reference, a division, a comparison, a conditional and a percentage of the parent."
			role: "bodySmall"
			wrap: true
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Visibility"
			role: "titleMedium"
		}

		Text {
			text:    "This line appears from sm (640dp) up."
			role:    "bodyMedium"
			visible: responsive {
				base: false
				sm: true
			}
		}

		Text {
			text:    "This one only below sm, and the layout closes the gap."
			role:    "bodyMedium"
			visible: responsive {
				base: true
				sm: false
			}
		}
	}

	// ---- data: one for loop, rows from Go.
	Column {
		spacing: 8

		Text {
			text: "Data rows"
			role: "titleMedium"
		}

		Column {
			id:      dataList
			spacing: 6
			width:   responsive {
				base: 280
				md: 420
			}

			for _, row := range bridge.rows {
				ListItem {
					label:       row.title
					supporting:  row.supporting
					leadingIcon: circle
				}
			}
		}

		Text {
			text:  "ui.SetData fills bridge.rows; the loop rebuilds when the list changes."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}

	// ---- conditional: a block switched by a Go-set bool.
	Column {
		spacing: 8

		Text {
			text: "Conditional block"
			role: "titleMedium"
		}

		Switch {
			id:      blockSwitch
			label:   "Show the wide layout"
			checked: true
		}

		if blockSwitch.checked {
			Card {
				variant: filled
				width:   responsive {
					base: 280
					md: 420
				}

				Text {
					text: "The if arm is shown."
				}
			}
		} else {
			Text {
				id:    blockElseLabel
				text:  "The else arm is shown."
				color: theme.onSurfaceVariant
			}
		}

		Text {
			text:  "Both arms are built; only the matching one is laid out, and the condition re-reads the switch every frame."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}
	}

	Column {
		spacing: 12

		Text {
			text: "Scroll snap"
			role: "titleMedium"
		}

		Text {
			text: "The wheel moves one card at a time, a drag settles on the nearer edge, and a fling stops at the next card."
			role: "bodySmall"
			wrap: true
		}

		// A vertical snap area: the axis is the Column's own, so there is no
		// x/y suffix, and scrollPadding keeps the card off the frame.
		Column {
			scrollSnapType: mandatory
			scrollSnapStop: stop
			scrollPadding:  12
			width:          responsive {
				base: 280
				md: 420
			}
			height:         260
			radius:         16
			background:     theme.surfaceContainerHigh
			padding:        12
			spacing:        12

			for i := range 4 {
				Card {
					label:           formatf("Card %d", i + 1)
					width:           100%
					height:          200
					radius:          12
					background:      theme.primaryContainer
					scrollSnapAlign: start
				}
			}
		}

		// The same on a Row: a sideways strip whose cards centre themselves.
		Row {
			scrollSnapType: proximity
			width:          responsive {
				base: 280
				md: 420
			}
			height:         120
			spacing:        12

			for i := range 5 {
				Card {
					label:           formatf("%d", i + 1)
					width:           150
					height:          100
					radius:          12
					background:      theme.secondaryContainer
					scrollSnapAlign: center
				}
			}
		}
	}

	// ---- breadcrumb: the crumbs are children and the trail draws the
	// separators, so each crumb keeps its own colour and links.
	Column {
		spacing: 8

		Text {
			text: "Breadcrumb"
			role: "titleMedium"
		}

		Breadcrumb {
			separatorColor: theme.onSurfaceVariant

			Text {
				text:  "Home"
				color: theme.onSurfaceVariant
			}

			Text {
				text:  "Library"
				color: theme.onSurfaceVariant
			}

			Text {
				text:  "Material"
				color: theme.onSurface
			}
		}
	}

	// ---- borderType: the same 2dp stroke, solid, dashed and dotted.
	Column {
		spacing: 8

		Text {
			text: "Border types"
			role: "titleMedium"
		}

		Row {
			spacing: 12

			Rectangle {
				width:           80
				height:          48
				radius:          10
				borderThickness: 2
				borderColor:     theme.primary
			}

			Rectangle {
				width:           80
				height:          48
				radius:          10
				borderThickness: 2
				borderColor:     theme.primary
				borderType:      dashed
			}

			Rectangle {
				width:           80
				height:          48
				radius:          10
				borderThickness: 2
				borderColor:     theme.primary
				borderType:      dotted
			}
		}
	}

	// ---- flex: one container, two axes. The direction is a property, so a
	// Go call or an expression flips the layout without a second subtree.
	Column {
		spacing: 8

		Text {
			text: "Flex"
			role: "titleMedium"
		}

		Flex {
			direction: row
			spacing:   12

			Rectangle {
				width:      48
				height:     48
				radius:     10
				background: theme.primary
			}

			Rectangle {
				width:      48
				height:     48
				radius:     10
				background: theme.secondaryContainer
			}

			Rectangle {
				width:      48
				height:     48
				radius:     10
				background: theme.tertiary
			}
		}

		Flex {
			direction: column
			spacing:   12

			Rectangle {
				width:      156
				height:     20
				radius:     10
				background: theme.primary
			}

			Rectangle {
				width:      156
				height:     20
				radius:     10
				background: theme.secondaryContainer
			}

			Rectangle {
				width:      156
				height:     20
				radius:     10
				background: theme.tertiary
			}
		}

		Text {
			text: "direction row and direction column, from the same element."
			role: "bodySmall"
		}
	}
}
