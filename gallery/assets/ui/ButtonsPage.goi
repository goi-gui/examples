Column {
	id:             pageButtons
	spacing:        24
	crossAxisAlign: start
	padding:        20

	Column {
		spacing: 10

		Text {
			text: "Buttons"
			role: "titleMedium"
		}

		Wrap {
			spacing: 8

			Button {
				label: "Filled"
			}

			Button {
				label:   "Tonal"
				variant: tonal
			}

			Button {
				label:   "Outlined"
				variant: outlined
			}

			Button {
				label:   "Text"
				variant: text
			}

			Button {
				label:   "Elevated"
				variant: elevated
			}

			Button {
				label:       "With icon"
				leadingIcon: add
			}

			Button {
				label:    "Disabled"
				disabled: true
			}
		}
	}

	// ---- state modifier: the same property paints differently for hover,
	// press and focus.
	Column {
		spacing: 10

		Text {
			text: "State modifier"
			role: "titleMedium"
		}

		Row {
			spacing:        12
			crossAxisAlign: center

			Button {
				label:      "Hover and press"
				background: state {
					default: theme.primary
					hover: theme.primaryContainer
					active: theme.tertiaryContainer
				}
				color:      state {
					default: theme.onPrimary
					hover: theme.onPrimaryContainer
					active: theme.onTertiaryContainer
				}
			}

			TextField {
				label:      "Focus me"
				width:      220
				background: state {
					default: theme.surfaceContainerHighest
					focus: theme.surfaceContainerLow
				}
			}
		}

		Text {
			text: "The button changes its container and label on hover and press; the field lifts its container under keyboard focus."
			role: "bodySmall"
			wrap: true
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Icon buttons"
			role: "titleMedium"
		}

		Wrap {
			spacing: 8

			IconButton {
				icon: favorite
			}

			IconButton {
				icon:    favorite
				variant: filled
			}

			IconButton {
				icon:    favorite
				variant: tonal
			}

			IconButton {
				icon:    favorite
				variant: outlined
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Button group"
			role: "titleMedium"
		}

		ButtonGroup {
			spacing: 8

			Button {
				label:       "Back"
				leadingIcon: arrow_back
			}

			Button {
				label:       "Next"
				leadingIcon: arrow_forward
			}
		}

		Text {
			text: "A row that shares one gap and one alignment, so the actions read as a set."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "FAB"
			role: "titleMedium"
		}

		Wrap {
			spacing: 16

			FAB {
				icon: edit
				size: 40
			}

			FAB {
				icon: add
			}

			FAB {
				label:   "Compose"
				icon:    edit
				variant: extended
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Styled by the design"
			role: "titleMedium"
		}

		Wrap {
			spacing: 16

			Button {
				label:           "Gradient"
				leadingIcon:     palette
				radius:          12
				color:           theme.onPrimary
				borderThickness: 1
				borderColor:     theme.outline
				background:      linear-gradient(120deg, theme.primary, theme.tertiary)
			}

			Button {
				label:           "Outlined accent"
				variant:         text
				color:           theme.tertiary
				radius:          10
				borderThickness: 1.5
				borderColor:     theme.tertiary
			}
		}

		Text {
			text: "background, border, radius, shadow and color replace the variant's own box."
			role: "bodySmall"
			wrap: true
		}
	}

	Column {
		spacing: 10

		Text {
			text: "FAB menu"
			role: "titleMedium"
		}

		FABMenu {
			id:       fabMenu
			icon:     add
			expanded: true

			FAB {
				icon: edit
				size: 40
			}

			FAB {
				icon: photo
				size: 40
			}

			FAB {
				icon: share
				size: 40
			}
		}

		Text {
			text: "The actions stack above the FAB while expanded; a closed menu has none."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Split button"
			role: "titleMedium"
		}

		// The menu segment's icon follows the button's own state: expand()
		// toggles it, and the expression reads it back every frame.
		SplitButton {
			id:           splitButton
			label:        "Split"
			leadingIcon:  add
			width:        200
			trailingIcon: splitButton.expanded ? arrow_upward : arrow_downward
			onClick:      splitButton.expand()
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Segmented button: radio"
			role: "titleMedium"
		}

		Row {
			spacing: 0

			SegmentedButton {
				label:   "Day"
				width:   84
				variant: single
			}

			SegmentedButton {
				label:    "Week"
				width:    84
				variant:  single
				selected: true
			}

			SegmentedButton {
				label:   "Month"
				width:   96
				variant: single
			}
		}

		Text {
			text: "variant: single keeps exactly one selected."
			role: "bodySmall"
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Segmented button: checkbox"
			role: "titleMedium"
		}

		Row {
			spacing: 0

			SegmentedButton {
				label: "Bold"
				width: 84
			}

			SegmentedButton {
				label:    "Italic"
				width:    84
				selected: true
			}

			SegmentedButton {
				label: "Underline"
				width: 108
			}
		}

		Text {
			text: "The default toggles each segment on its own; clicking a selected one clears it."
			role: "bodySmall"
		}
	}

	// ---- ripple: press feedback is a property, so a plain surface can have one
	// and a control that ripples by default can drop it. Press any of these.
	Column {
		spacing: 10

		Text {
			text: "Ripple"
			role: "titleMedium"
		}

		Row {
			spacing:        12
			crossAxisAlign: center

			Rectangle {
				width:      120
				height:     48
				radius:     24
				background: theme.primaryContainer
				ripple:     true
			}

			Rectangle {
				width:      120
				height:     48
				radius:     8
				background: theme.secondaryContainer
				ripple:     true
			}

			Image {
				src:    "goi://images/sample.jpg"
				width:  96
				height: 48
				radius: 8
				ripple: true
			}

			Chip {
				label:  "Chip, off"
				ripple: false
			}

			Button {
				label:  "Button, off"
				ripple: false
			}
		}

		Text {
			text: "A pill, a rounded box and a picture with ripple: true; a chip and a button with ripple: false, though both ripple by default. The disc is clipped to the shape it belongs to."
			role: "bodySmall"
			wrap: true
		}
	}
}
