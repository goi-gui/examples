Column {
	id:             pageMotion
	visible:        false
	spacing:        24
	padding:        20
	crossAxisAlign: start

	Column {
		spacing: 10

		Text {
			text: "Easing"
			role: "titleMedium"
		}

		Text {
			text:  "One distance, three curves. Linear keeps a constant speed, Standard starts fast and lands soft, Emphasized is slow at both ends. Press Play to run them together."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Column {
			width:   300
			spacing: 14

			Column {
				spacing: 4

				Text {
					text: "Linear"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotLinear
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}

			Column {
				spacing: 4

				Text {
					text: "Standard"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotStandard
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}

			Column {
				spacing: 4

				Text {
					text: "Emphasized"
					role: "labelMedium"
				}

				Stack {
					height: 36

					Positioned {
						left:       0
						right:      0
						top:        16
						height:     4
						background: theme.surfaceContainerHighest
						radius:     2
					}

					Positioned {
						id:     dotEmphasized
						left:   0
						top:    0
						width:  36
						height: 36

						Rectangle {
							width:      36
							height:     36
							radius:     18
							background: theme.primary
						}
					}
				}
			}
		}

		Button {
			id:          playEasing
			label:       "Play"
			leadingIcon: play_arrow
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Value"
			role: "titleMedium"
		}

		Text {
			text:  "app.Animate moves any numeric Prop, so a slider and a progress ring follow the same tween without a special animation API."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 420
			}
		}

		Row {
			spacing: 24

			Slider {
				id:    motionSlider
				value: 0.25
				width: 240
			}

			CircularProgress {
				id:     motionProgress
				value:  0.3
				width:  64
				height: 64
			}
		}

		Button {
			id:          playValue
			label:       "Animate value"
			leadingIcon: play_arrow
			variant:     tonal
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Gestures"
			role: "titleMedium"
		}

		Text {
			text:  "A GestureDetector reports a pan, a double tap and a long press beside the click every element has. Drag the card; double-tap it to reset it, or hold it."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 460
			}
		}

		Stack {
			width:  100%
			height: 180

			Rectangle {
				width:      100%
				height:     100%
				radius:     16
				background: theme.surfaceContainerHigh
			}

			Positioned {
				id:   dragBox
				left: 16
				top:  16

				GestureDetector {
					id:     dragKnob
					width:  140
					height: 96
					radius: 16
					cursor: grab

					Rectangle {
						width:      100%
						height:     100%
						radius:     16
						background: theme.primary
					}

					Text {
						id:    dragState
						text:  "Drag me"
						role:  "labelLarge"
						color: theme.onPrimary
						align: center
					}
				}
			}
		}
	}

	Column {
		spacing: 10

		Text {
			text: "Shared element"
			role: "titleMedium"
		}

		Text {
			text:  "Two Heroes with the same tag share one flight. Press Fly and the small tile travels from its box into the large one; the destination stays hidden until it lands."
			role:  "bodySmall"
			wrap:  true
			width: responsive {
				base: 280
				md: 460
			}
		}

		Stack {
			width:          100%
			height:         220
			crossAxisAlign: center
			mainAxisAlign:  center

			Rectangle {
				width:      100%
				height:     100%
				radius:     16
				background: theme.surfaceContainerHigh
			}

			Hero {
				id:       heroSmall
				tag:      "galleryCover"
				duration: 450ms
				width:    120
				height:   120

				Stack {
					Rectangle {
						width:      100%
						height:     100%
						radius:     24
						background: theme.primary
					}

					Text {
						text:  "Hero"
						role:  "titleMedium"
						color: theme.onPrimary
						align: center
					}
				}
			}

			Hero {
				id:       heroBig
				tag:      "galleryCover"
				duration: 450ms
				visible:  false
				width:    300
				height:   180

				Stack {
					Rectangle {
						width:      100%
						height:     100%
						radius:     28
						background: theme.tertiary
					}

					Text {
						text:  "Hero"
						role:  "headlineSmall"
						color: theme.onTertiary
						align: center
					}
				}
			}
		}

		Button {
			id:          heroToggle
			label:       "Fly"
			leadingIcon: open_in_full
			variant:     tonal
		}
	}
}
