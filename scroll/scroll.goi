// Scroll example: a vertical page, a horizontal strip and Go-driven offsets.
//
// The wheel scrolls whatever sits under the pointer; a press-and-drag scrolls
// too, and the click it started on is cancelled. A container scrolls when it
// sets `scroll: true`; a Row scrolls sideways, everything else vertically.
// A scroll container still needs a bounded main-axis size, here `flex: 1`.
//
// The bar hides itself two seconds after the pointer leaves unless
// `autoHideScrollbar: false`; `hideScrollbar: true` removes it, and
// `scrollShadow: true` fades an edge while content is hidden there. The thumb
// is draggable, and `scrollbarWidth` makes it easier to hit. `opacity` fades
// at the bottom of the page.

Window {
	id:     main
	title:  "Scroll"
	width:  520
	height: 480
	theme:  light

	Column {
		padding: 16
		spacing: 12

		Text {
			text: "Scroll"
			role: "headlineSmall"
		}

		Text {
			text: "Drag or wheel the page, and the chip row sideways."
			role: "bodyMedium"
		}

		// A Row scrolls horizontally: the chips overflow the 488 dp strip.
		Row {
			id:           strip
			scroll:       true
			scrollShadow: true
			spacing:      8

			Chip {
				label: "one"
			}

			Chip {
				label: "two"
			}

			Chip {
				label: "three"
			}

			Chip {
				label: "four"
			}

			Chip {
				label: "five"
			}

			Chip {
				label: "six"
			}

			Chip {
				label: "seven"
			}

			Chip {
				label: "eight"
			}

			Chip {
				label: "nine"
			}

			Chip {
				label: "ten"
			}
		}

		// A Column scrolls vertically. The axis must be bounded, here by a
		// height; flex: 1 works when the parent bounds the main axis too.
		Column {
			id:             page
			height:         340
			scroll:         true
			scrollShadow:   true
			scrollbarWidth: 6
			spacing:        8

			Card {
				label:      "Card 1"
				supporting: "Scroll to see the rest"
				height:     88
			}

			Card {
				label:      "Card 2"
				supporting: "Nine cards do not fit"
				height:     88
			}

			Card {
				label:  "Card 3"
				height: 88
			}

			Card {
				label:  "Card 4"
				height: 88
			}

			Card {
				label:  "Card 5"
				height: 88
			}

			Card {
				label:  "Card 6"
				height: 88
			}

			Card {
				label:  "Card 7"
				height: 88
			}

			Card {
				label:  "Card 8"
				height: 88
			}

			Card {
				label:  "Card 9"
				height: 88
			}
		}

		// Offsets are plain Go state: SetScrollOffset clamps when read, so a
		// far value lands on the last page instead of scrolling into the void.
		Row {
			spacing: 8

			Button {
				id:      top
				label:   "Top"
				variant: tonal
			}

			Button {
				id:    end
				label: "End"
			}
		}

		// Opacity fades the box and everything inside it. A percentage is the
		// same range: 35% is 0.35.
		Row {
			spacing: 12

			Rectangle {
				width:      80
				height:     40
				radius:     8
				background: primary
			}

			Rectangle {
				width:      80
				height:     40
				radius:     8
				background: primary
				opacity:    35%
			}

			Text {
				text: "opacity 1 and 35%"
				role: "labelMedium"
			}
		}
	}
}
