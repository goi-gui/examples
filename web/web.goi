// The counter, running in a canvas: the same design as examples/counter, so the
// browser build is one file and no assets.

Window {
	id:     main
	title:  "Counter"
	width:  480
	height: 400
	theme:  light

	Column {
		spacing: 0

		TopAppBar {
			id:    appbar
			label: "Counter"
		}

		Column {
			flex:           1
			padding:        32
			spacing:        24
			crossAxisAlign: center

			Card {
				variant: filled
				width:   360

				Column {
					spacing:        12
					crossAxisAlign: center

					Text {
						text:  "Total"
						role:  "labelLarge"
						color: theme.onSurfaceVariant
					}

					Text {
						id:    label
						text:  "0"
						role:  "displayLarge"
						color: theme.primary
					}

					Row {
						width:     92
						alignSelf: center
						spacing:   12

						IconButton {
							id:      dec
							icon:    remove
							variant: outlined
						}

						IconButton {
							id:      inc
							icon:    add
							variant: filled
						}
					}

					Button {
						id:       reset
						label:    "Reset"
						variant:  text
						disabled: true
					}
				}
			}
		}
	}
}
