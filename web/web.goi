// The same design language as the desktop examples: this file runs unchanged in
// a browser.

bridge {
	onStep func(delta int)
}

Window {
	id:     web
	title:  "goi in the browser"
	width:  640
	height: 760
	theme:  light

	Column {
		padding: 24
		gap:     16
		width:   100%
		scroll:  true

		Text {
			text: "goi, in a canvas"
			role: headlineSmall
		}

		Text {
			text: "One .goi file, the same tree, laid out and drawn with WebGPU."
			role: bodyMedium
		}

		Row {
			gap:           12
			mainAxisAlign: center

			Button {
				icon:    remove
				variant: tonal
				onClick: bridge.onStep(-1)
			}

			TextField {
				id:          name
				width:       160
				label:       "Type"
				placeholder: "type here"
			}

			Button {
				icon:    add
				variant: filled
				onClick: bridge.onStep(1)
			}
		}

		Video {
			id:       clip
			width:    100%
			height:   220
			src:      "goi://assets/clip.mp4"
			controls: true
			loop:     true
			muted:    true
			autoplay: true
		}

		Button {
			id:      pick
			label:   "Pick a file"
			variant: outlined
		}

		Text {
			id:   status
			text: "0"
			role: titleMedium
		}

		Card {
			width:      100%
			height:     110
			label:      "Clicks"
			supporting: "The number above is the state; this card proves layout inside a browser canvas."
		}

		LineChart {
			id:     trend
			width:  100%
			height: 200
			legend: true
			points: true
			smooth: true
		}
	}
}
