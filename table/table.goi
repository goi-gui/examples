// Table: a sortable data grid the app fills from Go.
//
// Columns are TableColumn children; `key` is what Go sorts by, `width` is a
// fixed width (omit it to share the leftover space), and `sortable` makes the
// header clickable. Rows are built by the loop, one TableRow per person, with
// one TableCell per column in order.
//
// Clicking a sortable header sorts; clicking a row selects it. The buttons call
// the same operations from Go (SortBy, SetSelectedRow).

bridge {
	people []person
	count  int
}

type person {
	name string
	role string
	team string
	age  int
}

Window {
	id:     main
	title:  "Table"
	width:  900
	height: 780
	theme:  app.systemMode

	Column {
		spacing: 0

		TopAppBar {
			label: "Table"
			icon:  "table_chart"
		}

		Column {
			id:             page
			flex:           1
			scroll:         true
			padding:        24
			spacing:        16
			crossAxisAlign: start

			Text {
				text: "Team directory"
				role: "headlineSmall"
			}

			Text {
				text:  "A sortable header shows a hand and an arrow. This table is selectable: multiple, so each click adds a row and clicking a selected row drops it. SortBy and SetSelectedRows do the same from Go."
				role:  "bodyMedium"
				wrap:  true
				width: 100%
			}

			Row {
				spacing: 8

				Button {
					id:      sortName
					label:   "Sort by name"
					variant: tonal
				}

				Button {
					id:      sortAge
					label:   "Sort by age, descending"
					variant: tonal
				}

				Button {
					id:      clearSort
					label:   "Declaration order"
					variant: text
				}

				Button {
					id:      selectFirstTwo
					label:   "Select first two"
					variant: text
				}
			}

			Table {
				id:         people
				width:      100%
				striped:    true
				selectable: multiple

				TableColumn {
					key:      "name"
					label:    "Name"
					icon:     "person"
					width:    25%
					sortable: true
				}

				TableColumn {
					key:      "role"
					label:    "Role"
					sortable: true
					width:    25%
					icon:     type_specimen
				}

				TableColumn {
					key:      "team"
					label:    "Team"
					width:    25%
					sortable: true
					icon:     group
				}

				TableColumn {
					key:      "age"
					label:    "Age"
					icon:     "cake"
					width:    25%
					numeric:  true
					sortable: true
					align:    start
				}

				for i, p := range bridge.people {
					TableRow {
						background: i == 0 ? theme.primary : ""

						TableCell {
							value: p.name

							Text {
								text: p.name
							}
						}

						TableCell {
							value: p.role

							Text {
								text: p.role
							}
						}

						TableCell {
							value: p.team

							Text {
								text: p.team
							}
						}

						TableCell {
							value: formatf("%d", p.age)

							Text {
								text: formatf("%d", p.age)
							}
						}
					}
				}
			}

			Text {
				text: formatf("%d people", bridge.count)
				role: "labelLarge"
			}

			Text {
				id:   sorted
				text: "declaration order"
				role: "labelMedium"
			}

			Text {
				id:   selected
				text: "no row selected"
				role: "labelMedium"
			}

			Divider {}

			Text {
				text: "Variants"
				role: "titleMedium"
			}

			Text {
				text:  "Outlined (the default), filled and plain. Only these three are accepted, because they are the styles the painter has."
				role:  "bodySmall"
				wrap:  true
				width: 100%
			}

			Row {
				width:   100%
				spacing: 16

				Column {
					flex:    1
					spacing: 6

					Text {
						text: "outlined"
						role: "labelMedium"
					}

					Table {
						width: 100%

						TableColumn {
							label: "Item"
							width: 50%
						}

						TableColumn {
							label: "State"
							width: 50%
						}

						TableRow {
							TableCell {
								value: "Build"

								Text {
									text: "Build"
								}
							}

							TableCell {
								value: "passing"

								Text {
									text: "passing"
								}
							}
						}

						TableRow {
							TableCell {
								value: "Tests"

								Text {
									text: "Tests"
								}
							}

							TableCell {
								value: "128"

								Text {
									text: "128"
								}
							}
						}
					}
				}

				Column {
					flex:    1
					spacing: 6

					Text {
						text: "filled"
						role: "labelMedium"
					}

					Table {
						width:   100%
						variant: filled

						TableColumn {
							label: "Item"
							width: 50%
						}

						TableColumn {
							label: "State"
							width: 50%
						}

						TableRow {
							TableCell {
								value: "Build"

								Text {
									text: "Build"
								}
							}

							TableCell {
								value: "passing"

								Text {
									text: "passing"
								}
							}
						}

						TableRow {
							TableCell {
								value: "Tests"

								Text {
									text: "Tests"
								}
							}

							TableCell {
								value: "128"

								Text {
									text: "128"
								}
							}
						}
					}
				}

				Column {
					flex:    1
					spacing: 6

					Text {
						text: "plain"
						role: "labelMedium"
					}

					Table {
						width:   100%
						variant: plain

						TableColumn {
							label: "Item"
							width: 50%
						}

						TableColumn {
							label: "State"
							width: 50%
						}

						TableRow {
							TableCell {
								value: "Build"

								Text {
									text: "Build"
								}
							}

							TableCell {
								value: "passing"

								Text {
									text: "passing"
								}
							}
						}

						TableRow {
							TableCell {
								value: "Tests"

								Text {
									text: "Tests"
								}
							}

							TableCell {
								value: "128"

								Text {
									text: "128"
								}
							}
						}
					}
				}
			}

			// A second table with different chrome: no header, short rows, no
			// surface of its own, and an icon in the first column.
			Text {
				text: "Recent activity"
				role: "titleMedium"
			}

			Text {
				text:  "The same component with variant: plain, showHeader: false, rowHeight: 36 and selectable: none, so its rows are inert."
				role:  "bodySmall"
				wrap:  true
				width: 100%
			}

			Table {
				id:         activity
				variant:    plain
				showHeader: false
				rowHeight:  36
				selectable: none

				TableColumn {
					width: 260
				}

				TableColumn {
					width: 160
				}

				TableRow {
					TableCell {
						value: "Build passed on linux/amd64"
						icon:  check_circle

						Text {
							text: "Build passed on linux/amd64"
						}
					}

					TableCell {
						value: "2 minutes ago"

						Text {
							text: "2 minutes ago"
						}
					}
				}

				TableRow {
					TableCell {
						value: "Release v0.4.7 published"
						icon:  cloud_upload

						Text {
							text: "Release v0.4.7 published"
						}
					}

					TableCell {
						value: "1 hour ago"

						Text {
							text: "1 hour ago"
						}
					}
				}

				TableRow {
					TableCell {
						value: "Two tests skipped"
						icon:  warning

						Text {
							text: "Two tests skipped"
						}
					}

					TableCell {
						value: "yesterday"

						Text {
							text: "yesterday"
						}
					}
				}
			}
		}
	}
}
