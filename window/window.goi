// Window properties: the size limits, resize, minimize, maximize and
// fullscreen. Each switch is a normal .goi property, so it can come from an
// expression as well as from the literal below.
//
// Run with: go run -ldflags=-linkmode=internal ./window

bridge {
	SetMin      func()
	ClearLimits func()
	Minimize    func()
	Maximize    func()
}

Window {
	id:          main
	title:       "Window"
	width:       760
	height:      660
	// Go can change these too: w.Root().SetMinWidth(...) writes the same cell.
	minWidth:    420
	minHeight:   360
	maxWidth:    1100
	maxHeight:   900
	resizable:   true
	minimizable: true
	maximizable: true
	fullscreen:  false
	theme:       app.systemMode

	Column {
		spacing: 0

		TopAppBar {
			label: "Window"
		}

		Column {
			flex:           1
			padding:        24
			spacing:        20
			crossAxisAlign: center

			Card {
				width:   520
				variant: filled

				Column {
					spacing: 12

					Text {
						text: "Size limits"
						role: "titleMedium"
					}

					Text {
						text: "minWidth 420 · minHeight 360 · maxWidth 1100 · maxHeight 900. Drag an edge and it stops at those bounds, and a maximum also turns maximize off."
						role: "bodySmall"
						wrap: true
					}

					Row {
						spacing: 8

						Chip {
							label: "min 420×360"
						}

						Chip {
							label: "max 1100×900"
						}
					}
				}
			}

			Card {
				width:   520
				variant: outlined

				Column {
					spacing: 12

					Text {
						text: "Chrome"
						role: "titleMedium"
					}

					Switch {
						id:    lockResize
						label: "Disable resize"
					}

					Switch {
						id:    lockMin
						label: "Disable minimize"
					}

					Switch {
						id:    lockMax
						label: "Disable maximize"
					}

					Switch {
						id:    fs
						label: "Fullscreen"
					}

					Text {
						id:   status
						text: "resize on · windowed"
						role: "bodySmall"
					}
				}
			}

			Card {
				width:   520
				variant: outlined

				Column {
					spacing: 12

					Text {
						text: "State and Go"
						role: "titleMedium"
					}

					// The platform reports these back every frame, so they follow
					// the title bar buttons too, not only what Go asked for.
					Text {
						id:   state
						text: "windowed · language tr"
						role: "bodySmall"
					}

					Row {
						spacing: 8

						Button {
							label:   "Minimize"
							onClick: bridge.Minimize()
						}

						Button {
							label:   "Maximize"
							onClick: bridge.Maximize()
						}

						Button {
							label:   "Set min 600×500"
							onClick: bridge.SetMin()
						}

						Button {
							label:   "Clear limits"
							onClick: bridge.ClearLimits()
						}
					}
				}
			}
		}
	}
}
