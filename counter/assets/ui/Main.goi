setup {
	var count = 0

	func inc() {
		count++
	}

	func dec() {
		count--
	}

	func reset() {
		count = 0
	}
}

Window {
	title: "Counter"

	Column {
		crossAxisAlign: center
		mainAxisAlign:  center
		gap:            20

		Text {
			text: "Counter"
			role: titleLarge
		}

		Row {
			gap:            20
			crossAxisAlign: center
			mainAxisAlign:  center

			Button {
				label:    "-"
				onClick:  dec()
				disabled: count == 0
			}

			Text {
				text: count
				role: displayLarge
			}

			Button {
				label:   "+"
				onClick: inc()
			}
		}

		IconButton {
			icon:     refresh
			onClick:  reset()
			disabled: count == 0
		}
	}
}
