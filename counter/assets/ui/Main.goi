bridge {
	Count   int
	onInc   func()
	onDec   func()
	onReset func()
}

Window {
	title: "Counter"

	Column {
		crossAxisAlign: center
		mainAxisAlign:  center
		gap:            20

		Text {
			text: "Counter"
			role: titleLarge
		}

		Row {
			gap:            20
			crossAxisAlign: center
			mainAxisAlign:  center

			Button {
				label:    "-"
				onClick:  bridge.onDec()
				disabled: bridge.Count == 0
			}

			Text {
				text: formatf("%02d", bridge.Count)
				role: displayLarge
			}

			Button {
				label:   "+"
				onClick: bridge.onInc()
			}
		}

		IconButton {
			icon:     refresh
			onClick:  bridge.onReset()
			disabled: bridge.Count == 0
		}
	}
}
