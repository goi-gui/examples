bridge {
	teams          []Team
	onToggleScheme func(isDark bool)
}

type Team {
	name            string
	position        int
	played          int
	won             int
	draw            int
	lost            int
	goalsFor        int
	goalsAgainst    int
	points          int
	lastFiveResults []string
	badge           string
}

Window {
	maximized: true
	theme:     app.systemMode
	title:     "Türkiye Super Lig Standings"

	Column {
		padding: 20
		gap:     20

		Row {
			width:          100%
			mainAxisAlign:  spaceBetween
			crossAxisAlign: center

			Text {
				text: "Türkiye Super Lig Standings"
				role: titleLarge
			}

			Switch {
				onToggle: bridge.onToggleScheme(event)
				checked:  app.mode == "dark"
				iconOff:  light_mode
				iconOn:   dark_mode
			}
		}

		Row {
			gap: 20

			Row {
				gap:            10
				crossAxisAlign: center
				mainAxisAlign:  center

				Rectangle {
					background: #0000ff66
					width:      20
					height:     20
					radius:     3
				}

				Text {
					text: "UEFA Champions League"
				}
			}

			Row {
				gap:            10
				crossAxisAlign: center
				mainAxisAlign:  center

				Rectangle {
					background: #fa7b1766
					width:      20
					height:     20
					radius:     3
				}

				Text {
					text: "UEFA Europe League"
				}
			}

			Row {
				gap:            10
				crossAxisAlign: center
				mainAxisAlign:  center

				Rectangle {
					background: #34a85366
					width:      20
					height:     20
					radius:     3
				}

				Text {
					text: "UEFA Conference League"
				}
			}

			Row {
				gap:            10
				crossAxisAlign: center
				mainAxisAlign:  center

				Rectangle {
					background: #ff000066
					width:      20
					height:     20
					radius:     3
				}

				Text {
					text: "Relegation Zone"
				}
			}
		}

		Table {
			width:        100%
			flex:         1
			scroll:       true
			striped:      true
			stickyHeader: true

			TableColumn {
				label:    "#"
				sortable: true
				width:    70
			}

			TableColumn {
				label:    "Name"
				sortable: true
				width:    200
			}

			TableColumn {
				label:    "P"
				sortable: true
			}

			TableColumn {
				label:    "W"
				sortable: true
			}

			TableColumn {
				label:    "D"
				sortable: true
			}

			TableColumn {
				label:    "L"
				sortable: true
			}

			TableColumn {
				label:    "GF"
				sortable: true
			}

			TableColumn {
				label:    "GA"
				sortable: true
			}

			TableColumn {
				label:    "A"
				sortable: true
			}

			TableColumn {
				label:    "PTS"
				sortable: true
			}

			TableColumn {
				label: "LAST 5"
				width: 170
			}

			for i, team := range bridge.teams {
				TableRow {
					background: conditional {
						"#0000ff66": i == 0 || i == 1
						"#fa7b1766": i == 2 || i == 3
						"#34a85366": i == 4
						"#ff000066": i == 15 || i == 16 || i == 17
					}

					TableCell {
						value: team.position

						Text {
							text: formatf("%d", team.position)
						}
					}

					TableCell {
						value: team.name

						Row {
							gap:            10
							crossAxisAlign: center

							Image {
								src:    team.badge
								width:  30
								height: 30
								fit:    cover
							}

							Text {
								text: team.name
							}
						}
					}

					TableCell {
						value: team.played

						Text {
							text: formatf("%d", team.played)
						}
					}

					TableCell {
						value: team.won

						Text {
							text: formatf("%d", team.won)
						}
					}

					TableCell {
						value: team.draw

						Text {
							text: formatf("%d", team.draw)
						}
					}

					TableCell {
						value: team.lost

						Text {
							text: formatf("%d", team.lost)
						}
					}

					TableCell {
						value: team.goalsFor

						Text {
							text: formatf("%d", team.goalsFor)
						}
					}

					TableCell {
						value: team.goalsAgainst

						Text {
							text: formatf("%d", team.goalsAgainst)
						}
					}

					TableCell {
						value: team.goalsFor - team.goalsAgainst

						Text {
							text: formatf("%d", team.goalsFor - team.goalsAgainst)
						}
					}

					TableCell {
						value: team.points

						Text {
							text:       formatf("%d", team.points)
							fontWeight: bold
						}
					}

					TableCell {
						value: 0

						Row {
							gap: 20

							for i, l := range team.lastFiveResults {
								Text {
									text: conditional {
										"🟢": l == "W"
										"🟡": l == "D"
										"🔴": l == "L"
									}
									role: titleLarge
								}
							}
						}
					}
				}
			}
		}
	}
}
